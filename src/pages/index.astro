---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoCard from "../components/VideoCard.astro";
import { Image } from "astro:assets";
import studioLogo from "../assets/brand/CSG-Logo_dark-v1.png";
import logo from "../assets/brand/game_title_logo-main.png";
import battle from "../assets/battle/long_battle.png";
import match from "../assets/battle/2v2.png";
import bowling from "../assets/bowling/minion-pins.png";
import survivors from "../assets/survivors/horde.png";
import defender from "../assets/classes/SecurityOfficer/SecurityOfficer.png";
import minion from "../assets/classes/Minions/Minion_solo.png";
import "../styles/homepage.css";
const modes = [
 {name:"Match",tag:"DEFEND. INVADE. DEPANTS.",text:"Save Earth's pants. Or steal every last pair. Defenders and alien Collectors turn the neighborhood into a battleground.",image:match,label:"Universe artwork",color:"#74caff",id:"match"},
 {name:"NOPAS Bowling",tag:"BIG BALL. LITTLE ALIENS.",text:"The pins are Minions. The Minions have complaints. Roll into ten-pin chaos with a very questionable alien workforce.",image:bowling,label:"Development screenshot",color:"#ffda56",id:"bowling"},
 {name:"NOPAS Survivors",tag:"MORE MINIONS. SEND HELP.",text:"Here comes the horde. Face waves of Minions and see how long you can keep the chaos under control.",image:survivors,label:"Development screenshot",color:"#a9ef79",id:"survivors"}
];
---
<BaseLayout title="NOPAS — One ridiculous universe. Three ways to play." description="Meet Not Our Pants, Alien Swine! Match, NOPAS Bowling and NOPAS Survivors. Three ways to play from Collapsed Star Games. Beta coming soon to Roblox.">
<div class="homepage">
<section class="hero" aria-labelledby="hero-title"><div class="hero-inner"><div class="hero-copy">
<div class="studio-lockup"><Image src={studioLogo} alt="Collapsed Star Games" widths={[120,240]} sizes="100px" loading="eager"/><p class="eyebrow studio-credit">COLLAPSED STAR GAMES<br/><span>PRESENTS</span></p></div>
<Image src={logo} alt="Not Our Pants, Alien Swine!" widths={[480,720,960]} sizes="(min-width: 800px) 490px, 90vw" class="game-logo" loading="eager"/>
<h1 id="hero-title">One ridiculous universe.<br/><span>Three ways to play.</span></h1>
<p class="hero-intro">Aliens came for our pants.<br/>We took that personally.</p>
<div class="hero-actions"><a class="button yellow" href="#gameplay"><span aria-hidden="true">▶</span> Watch videos</a><a class="button outline" href="#modes">Meet the modes ↓</a></div>
<p class="availability"><span class="status-dot"></span>Beta coming soon <span class="divider">/</span> Coming to Roblox</p>
</div><div class="hero-art"><Image src={battle} alt="NOPAS universe artwork: defenders face orange alien Minions beneath a hovering mothership" widths={[640,960,1280]} sizes="(min-width: 800px) 50vw, 100vw" loading="eager"/><span class="comic-callout"><svg viewBox="0 0 260 156" aria-hidden="true"><path d="M19 66 4 43 53 44 43 14 89 29 105 4 134 25 169 9 174 32 218 22 210 48 251 55 229 78 255 101 218 106 224 136 183 126 167 151 137 132 106 147 96 127 54 143 58 116 17 121 28 94 5 84Z" fill="#ffdb56" stroke="#131326" stroke-width="5" stroke-linejoin="round"/><path d="m44 58 17-4m138 54 13 5M76 35l6 8m126 30 14-2" fill="none" stroke="#131326" stroke-width="3" stroke-linecap="round"/></svg><span>NOT OUR<br/><strong>PANTS!</strong></span></span><span class="art-caption">Universe artwork</span></div></div></section>
<div class="ticker" aria-hidden="true"><span>ONE UNIVERSE</span><b>✦</b><span>THREE WAYS TO PLAY</span><b>✦</b><span>ZERO SPARE PANTS</span><b>✦</b><span>ONE UNIVERSE</span></div>
<section id="modes" class="modes section-pad" aria-labelledby="modes-title"><div class="section-heading"><div><p class="eyebrow">PICK YOUR KIND OF CHAOS</p><h2 id="modes-title">Same aliens. New problems.</h2></div><p>Three modes. One shared universe.<br/>All planned for the upcoming beta.</p></div>
<div class="mode-grid">{modes.map((mode,i)=><article class="mode-card" id={mode.id} style={`--mode-color:${mode.color}`}><div class="mode-image"><Image src={mode.image} alt={mode.name === "Match" ? "Defenders and aliens in a NOPAS battle illustration" : mode.name === "NOPAS Bowling" ? "Orange Minion pins face a blue bowling ball on a NOPAS lane" : "A player faces a large crowd of orange Minions"} widths={[480,720,960]} sizes="(min-width: 800px) 31vw, 90vw" loading="lazy"/><span>{mode.label}</span><b class="mode-number" aria-hidden="true">0{i+1}</b></div><div class="mode-copy"><p class="eyebrow">{mode.tag}</p><h3><a href={mode.id === "survivors" ? "/nopas/survivors/" : mode.id === "bowling" ? "/nopas/bowling/" : "/nopas/#match"}>{mode.name} <span aria-hidden="true">↗</span></a></h3><p class="mode-description">{mode.text}</p><p class="beta-label"><span class="status-dot"></span>Beta coming soon</p></div></article>)}</div>
<p class="mode-note">The invasion is still taking shape. Beta timing and availability will be announced.</p></section>
<section class="characters section-pad" aria-labelledby="characters-title"><div class="character-intro"><p class="eyebrow">MEET THE USUAL SUSPECTS</p><h2 id="characters-title">Big personalities.<br/><span>Tiny respect for pants.</span></h2><p>Same faces. Same terrible intentions. Get to know the heroes defending Earth's denim—and the aliens with a deeply unnecessary collection habit.</p><a class="text-link" href="/nopas/">Enter the NOPAS universe ↗</a><p class="art-note">Character artwork</p></div>
<a class="character-card defender" href="/nopas/defenders/"><Image src={defender} alt="The armored Security Officer in the NOPAS universe" widths={[360,600]} sizes="(min-width: 800px) 25vw, 44vw" loading="lazy"/><div><p class="eyebrow">THE DEFENDERS</p><h3>Save the denim.</h3><span>Meet the UPDF ↗</span></div></a>
<a class="character-card collector" href="/nopas/collectors/"><Image src={minion} alt="An orange alien Minion" widths={[360,600]} sizes="(min-width: 800px) 25vw, 44vw" loading="lazy"/><div><p class="eyebrow">THE COLLECTORS</p><h3>Steal the denim.</h3><span>Meet the aliens ↗</span></div></a></section>
<section id="gameplay" class="gameplay section-pad" aria-labelledby="gameplay-title"><div class="section-heading"><div><p class="eyebrow">TRANSMISSION FROM THE FRONT LINES</p><h2 id="gameplay-title">Yes, it gets ridiculous.</h2></div><p>Actual development footage.<br/>Things may change before beta.</p></div>
<div class="video-grid"><VideoCard id="kSqdf0DlD8s" title="Commander Depantsing"/><VideoCard id="-fuITOqPR1Q" title="The Commander Attacks"/><VideoCard id="CQkpU3rfi1E" title="Defender Gets Ballooninated"/></div></section>
<section id="studio" class="studio section-pad"><div><p class="eyebrow">SMALL STUDIO. COSMICALLY QUESTIONABLE IDEAS.</p><h2>Collapsed Star Games.</h2><p>We're an independent studio building games to be remembered, replayed, and shared. First mission: save the pants.</p></div><a href="mailto:info@collapsedstargames.com" class="button yellow">Get in touch ↗</a></section>
</div>
</BaseLayout>
