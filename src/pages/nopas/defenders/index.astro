---
import "../../../styles/nopas-characters.css";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import secOfficerHero from "../../../assets/classes/SecurityOfficer/SecurityOfficer.png";
import tailorHero from "../../../assets/classes/TailorEngineer/TailorEngineer.png";
import drPeepersHero from "../../../assets/classes/DrPeepers/DrPeepers.png";
import athleteHero from "../../../assets/classes/Athlete/Athlete.png";
import needleEyeHero from "../../../assets/classes/NeedleEye/NeedleEye.png";
import citizenThumb from "../../../assets/classes/Citizen/citizen_3.png";
import battle2 from "../../../assets/battle/2v2.png";
---

<BaseLayout
    title="The United Pants Defense Force"
    description="The UPDF is made up of specialized heroes with very questionable training and very strong opinions about pants. Meet the five Defender classes — Security Officer, Tailor Engineer, Dr. Peepers, Athlete, and Needle Eye — and hold the line."
>
<div class="character-pages defenders roster-page">
    {/* ============================================================
        Hero
       ============================================================ */}
    <section class="character-hero faction-hero"><div><a class="character-back" href="/nopas/">← NOPAS overview</a><p class="character-eyebrow">
                The United Pants Defense Force
            </p><h1>
                EVERY PERSON DESERVES A GOOD PAIR OF
                <span>JEANS.</span>
            </h1><p>
                When the first saucers appeared, the world panicked. When the first pants
                disappeared, the world got organized. The UPDF was formed to stop alien
                Collectors from stripping Earth of dignity, denim, and elastic waistbands.
            </p><p>
                Not the biggest army. Not the most organized army. Definitely not the
                cleanest army. But they are the only thing standing between humanity and
                a pantsless future.
            </p><p>
                &ldquo;This ends today. Not Our Pants, Alien Swine!&rdquo;
            </p><p>
                UPDF Motto
            </p><a class="character-button" href="#roster">Meet the roster ↓</a></div><figure><Image src={battle2} alt="Defenders face the Collector invasion in NOPAS battle artwork" widths={[640,960]} sizes="(min-width: 800px) 46vw, 90vw" loading="eager"/><figcaption>Character artwork · NOPAS universe</figcaption></figure></section>

    {/* ============================================================
        The roster — compact thumbnail grid (6 cards: 5 Defenders + Citizen)
       ============================================================ */}
    <section id="roster" class="character-section character-roster max-w-7xl mx-auto px-6 py-10">
        <div class="text-center mb-6">
            <p class="font-display text-xs tracking-[0.3em] uppercase">
                The Roster
            </p>
            <h2 class="font-display text-2xl md:text-4xl mt-2 text-paper-glow">
                Six members. One mission.
            </h2>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            <a href="/nopas/defenders/security-officer/" class="group block surface rounded-lg overflow-hidden hover:bg-[var(--surface-hover)] transition">
                <div class="relative aspect-[3/4] overflow-hidden bg-[var(--bg-deep)]">
                    <Image src={secOfficerHero} alt="" widths={[320, 480, 720]} sizes="(min-width: 1000px) 360px, (min-width: 600px) 45vw, 90vw" class="w-full h-full object-contain  transition-transform" loading="lazy" />
                </div>
                <div class="p-3">
                    <p class="font-display tracking-[0.25em] uppercase truncate">Anchor</p>
                    <h3 class="mt-0.5 font-display text-sm md:text-base leading-tight">Security Officer</h3>
                </div>
            </a>

            <a href="/nopas/defenders/tailor-engineer/" class="group block surface rounded-lg overflow-hidden hover:bg-[var(--surface-hover)] transition">
                <div class="relative aspect-[3/4] overflow-hidden bg-[var(--bg-deep)]">
                    <Image src={tailorHero} alt="" widths={[320, 480, 720]} sizes="(min-width: 1000px) 360px, (min-width: 600px) 45vw, 90vw" class="w-full h-full object-contain  transition-transform" loading="lazy" />
                </div>
                <div class="p-3">
                    <p class="font-display tracking-[0.25em] uppercase truncate">Builder</p>
                    <h3 class="mt-0.5 font-display text-sm md:text-base leading-tight">Tailor Engineer</h3>
                </div>
            </a>

            <a href="/nopas/defenders/dr-peepers/" class="group block surface rounded-lg overflow-hidden hover:bg-[var(--surface-hover)] transition">
                <div class="relative aspect-[3/4] overflow-hidden bg-[var(--bg-deep)]">
                    <Image src={drPeepersHero} alt="" widths={[320, 480, 720]} sizes="(min-width: 1000px) 360px, (min-width: 600px) 45vw, 90vw" class="w-full h-full object-contain  transition-transform" loading="lazy" />
                </div>
                <div class="p-3">
                    <p class="font-display tracking-[0.25em] uppercase truncate">Medic</p>
                    <h3 class="mt-0.5 font-display text-sm md:text-base leading-tight">Dr. Peepers</h3>
                </div>
            </a>

            <a href="/nopas/defenders/athlete/" class="group block surface rounded-lg overflow-hidden hover:bg-[var(--surface-hover)] transition">
                <div class="relative aspect-[3/4] overflow-hidden bg-[var(--bg-deep)]">
                    <Image src={athleteHero} alt="" widths={[320, 480, 720]} sizes="(min-width: 1000px) 360px, (min-width: 600px) 45vw, 90vw" class="w-full h-full object-contain  transition-transform" loading="lazy" />
                </div>
                <div class="p-3">
                    <p class="font-display tracking-[0.25em] uppercase truncate">Rescue</p>
                    <h3 class="mt-0.5 font-display text-sm md:text-base leading-tight">The Athlete</h3>
                </div>
            </a>

            <a href="/nopas/defenders/needle-eye/" class="group block surface rounded-lg overflow-hidden hover:bg-[var(--surface-hover)] transition">
                <div class="relative aspect-[3/4] overflow-hidden bg-[var(--bg-deep)]">
                    <Image src={needleEyeHero} alt="" widths={[320, 480, 720]} sizes="(min-width: 1000px) 360px, (min-width: 600px) 45vw, 90vw" class="w-full h-full object-contain  transition-transform" loading="lazy" />
                </div>
                <div class="p-3">
                    <p class="font-display tracking-[0.25em] uppercase truncate">Sniper</p>
                    <h3 class="mt-0.5 font-display text-sm md:text-base leading-tight">Needle Eye</h3>
                </div>
            </a>

            <a href="/nopas/defenders/citizen/" class="group block surface rounded-lg overflow-hidden hover:bg-[var(--surface-hover)] transition">
                <div class="relative aspect-[3/4] overflow-hidden bg-[var(--bg-deep)]">
                    <Image src={citizenThumb} alt="" widths={[320, 480, 720]} sizes="(min-width: 1000px) 360px, (min-width: 600px) 45vw, 90vw" class="w-full h-full object-contain  transition-transform" loading="lazy" />
                </div>
                <div class="p-3">
                    <p class="font-display tracking-[0.25em] uppercase truncate">Non-Combat</p>
                    <h3 class="mt-0.5 font-display text-sm md:text-base leading-tight">Citizens</h3>
                </div>
            </a>
        </div>
    </section>

    {/* ============================================================
        Which Defender Should You Play? — compact
       ============================================================ */}
    <section class="character-section max-w-5xl mx-auto px-6 py-10">
        <div class="text-center mb-6">
            <p class="font-display text-xs tracking-[0.3em] uppercase">
                Pick Your Role
            </p>
            <h2 class="font-display text-2xl md:text-3xl mt-2 text-paper-glow">
                Which Defender should you play?
            </h2>
        </div>

        <div>
            <a href="/nopas/defenders/security-officer/" class="group flex items-baseline gap-4 py-2.5 border-b border-[var(--border-subtle)] hover:border-[var(--color-denim-400)]/30 transition">
                <p class="font-display text-base md:text-lg flex-1">Want to <span class="">hold the line</span>?</p>
                <p class="font-display text-sm transition shrink-0">Meet <strong class="">Security Officer</strong> →</p>
            </a>
            <a href="/nopas/defenders/tailor-engineer/" class="group flex items-baseline gap-4 py-2.5 border-b border-[var(--border-subtle)] hover:border-[var(--color-golden-400)]/30 transition">
                <p class="font-display text-base md:text-lg flex-1">Want to <span class="">build the line</span>?</p>
                <p class="font-display text-sm transition shrink-0">Meet <strong class="">Tailor Engineer</strong> →</p>
            </a>
            <a href="/nopas/defenders/dr-peepers/" class="group flex items-baseline gap-4 py-2.5 border-b border-[var(--border-subtle)] hover:border-[#5eddb0]/30 transition">
                <p class="font-display text-base md:text-lg flex-1">Want to <span class="">keep the line alive</span>?</p>
                <p class="font-display text-sm transition shrink-0">Meet <strong class="">Dr. Peepers</strong> →</p>
            </a>
            <a href="/nopas/defenders/athlete/" class="group flex items-baseline gap-4 py-2.5 border-b border-[var(--border-subtle)] hover:border-[#ff7547]/30 transition">
                <p class="font-display text-base md:text-lg flex-1">Want to <span class="">sprint past the line and rescue someone screaming</span>?</p>
                <p class="font-display text-sm transition shrink-0">Meet <strong class="">Athlete</strong> →</p>
            </a>
            <a href="/nopas/defenders/needle-eye/" class="group flex items-baseline gap-4 py-2.5 border-b border-[var(--border-subtle)] hover:border-[#8edcff]/30 transition">
                <p class="font-display text-base md:text-lg flex-1">Want to <span class="">watch the line from a rooftop and judge everyone's positioning</span>?</p>
                <p class="font-display text-sm transition shrink-0">Meet <strong class="">Needle Eye</strong> →</p>
            </a>
            <a href="/nopas/defenders/citizen/" class="group flex items-baseline gap-4 py-2.5 hover:border-[#ffc14d]/30 transition">
                <p class="font-display text-base md:text-lg flex-1">Want to <span class="">panic responsibly while someone heroically saves you</span>?</p>
                <p class="font-display text-sm transition shrink-0">Meet <strong class="">Citizen</strong> →</p>
            </a>
        </div>
    </section>

    {/* ============================================================
        UPDF Field Manual — compact
       ============================================================ */}
    <section class="character-section max-w-3xl mx-auto px-6 py-10">
        <div class="surface rounded-lg p-5 border-l-2 border-[var(--color-denim-500)]/40">
            <p class="font-display text-xs tracking-[0.3em] uppercase">UPDF Field Manual</p>
            <h2 class="mt-1 font-display text-xl">The five official rules of pants defense.</h2>
            <ol class="mt-4 space-y-1.5 text-sm">
                <li class="flex gap-3"><span class="font-display w-5 shrink-0">1.</span><span>Citizens are safer indoors.</span></li>
                <li class="flex gap-3"><span class="font-display w-5 shrink-0">2.</span><span>Aliens hate organized Defenders.</span></li>
                <li class="flex gap-3"><span class="font-display w-5 shrink-0">3.</span><span>Motherships are easier to hit when they get cocky.</span></li>
                <li class="flex gap-3"><span class="font-display w-5 shrink-0">4.</span><span>Never trust an orange minion near laundry.</span></li>
                <li class="flex gap-3"><span class="font-display w-5 shrink-0">5.</span><span>If all else fails, shout <em class="">&ldquo;Not our pants!&rdquo;</em> and keep firing.</span></li>
            </ol>
        </div>
    </section>

    {/* ============================================================
        Tagline strip — compact
       ============================================================ */}
    <section class="character-section border-y border-[var(--color-denim-500)]/15 py-5 overflow-hidden">
        <div class="max-w-6xl mx-auto px-6">
            <ul class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-center font-display text-xs tracking-wider uppercase">
                <li>Not our pants. Not today.</li>
                <li class="">Enough is enough, Alien Swine!</li>
                <li>No pants left behind.</li>
                <li class="">The waistband war ends here.</li>
                <li>Standing between Earth and galactic indecency.</li>
            </ul>
        </div>
    </section>

    {/* ============================================================
        Recruitment CTA — compact
       ============================================================ */}
    <section class="character-section max-w-3xl mx-auto px-6 py-10 text-center">
        <h2 class="font-display text-2xl md:text-3xl text-paper-glow">
            Because someone has to tell the aliens no.
        </h2>
        <p class="mt-3 text-sm">
            Benefits include official badge access, questionable equipment, hazard
            pay, opportunities for heroism, frequent yelling, and pants retention.
        </p>
        <div class="mt-5 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/nopas/defenders/security-officer/" class="font-display text-sm tracking-wider px-5 py-2.5 bg-[var(--color-denim-500)] rounded-md hover:bg-[var(--color-denim-400)] transition">
                Start with Security Officer →
            </a>
            <a href="/nopas/collectors/" class="font-display text-sm tracking-wider px-5 py-2.5 border border-[var(--border-strong)] rounded-md hover:bg-[var(--surface-hover)] transition">
                or join the Collectors instead
            </a>
        </div>
    </section>
<nav class="character-footer-nav" aria-label="Explore the factions"><a href="/nopas/">← NOPAS overview</a><a href="/nopas/defenders/">Meet the Defenders ↗</a><a href="/nopas/collectors/">Meet the Collectors ↗</a><a href="/nopas/survivors/">Survivors guide ↗</a></nav>
</div>
</BaseLayout>
