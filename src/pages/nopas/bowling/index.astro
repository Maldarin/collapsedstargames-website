---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import pins from "../../../assets/bowling/minion-pins.png";
import aim from "../../../assets/bowling/aim-ui.png";
import draft from "../../../assets/bowling/build-a-ball.png";
import kingpin from "../../../assets/bowling/kingpin-tumble.png";
import strike from "../../../assets/bowling/strike.png";
import arcade from "../../../assets/bowling/arcade.png";
import shrunken from "../../../assets/bowling/shrunken-pin.png";
import mutation from "../../../assets/bowling/mutation-roll.png";
import "../../../styles/nopas-overview.css";
import "../../../styles/nopas-bowling.css";

const features = [
  { tag: "MUTANT MINION PINS", title: "The pins fight back. Passively.", body: "Balloon Minions drift. Shrunken Minions hide. Mega Minions refuse to fall. Rubber Minions ricochet, Magnetic Minions pull your ball off course, and the rare Golden-Pants Minion pays a bounty on the way down.", note: "Log every mutation you topple in the Minion Mugshot Collection." },
  { tag: "BUILD-A-BALL DRAFT", title: "UPDF weapons research, misapplied.", body: "Draft two limited-use ball abilities per match—Starch Bomb shockwaves, Button Blaster shrapnel, the split-threading Shrinkinator, the unhinged Ballooninator, the target-seeking Tractor Ball, and more.", note: "Charge them with strikes and spares. Spend them wisely. Or don't." },
  { tag: "LANE MUTATION EVENTS", title: "The lane has moods.", body: "Announced frames where the lane itself misbehaves: Moon Pants Gravity, Disco Depantsing dance floors, Laundry Cyclone crosswinds, a slowly drifting pin deck, Pantsquakes, bank-shot Alien Geometry, and a Minion Union Strike, complete with protest signs.", note: "Always announced before your throw. Never an excuse." },
  { tag: "KINGPIN BOUNTY", title: "One Minion thinks he's in charge.", body: "Some frames crown one pin the Kingpin—with a crown, cape, or a ‘Definitely Not the Kingpin’ sign. Drop him first throw to claim the bounty. Miss, and it grows and carries to the next player, who will absolutely steal it from you.", note: "Never changes your bowling score. Only your reputation." },
  { tag: "BONUS ROUNDS", title: "Minion Panic, scheduled.", body: "Short mid-match interruptions: bowl down a Minion Stampede, stop a Golden-Pants runner in Protect the Pants, demolish an absurd Minion Pyramid, or team up to topple a giant Minion in Boss Bowl.", note: "Separate rewards. Your real score stays sacred." },
  { tag: "BETWEEN TURNS", title: "Waiting is also a game.", body: "Lane-side arcade mini-games against friends or the house while you wait your turn, a dedicated taunt zone, and full celebrations when someone strings a Turkey—three strikes, one very confused turkey-costumed Minion.", note: "A perfect game gets the Golden Pants spotlight. Earn it." },
];
const gallery = [
  { image: mutation, title: "Mutation frame", caption: "Frame 7. Four of those pins are not normal.", alt: "A ball rolls toward orange Minion pins during a Mutation Frame" },
  { image: strike, title: "A very good throw", caption: "Strike. Kingpin claimed. Bounty collected.", alt: "A STRIKE celebration with a Kingpin bounty claimed" },
  { image: kingpin, title: "Definitely not the Kingpin", caption: "Moments before becoming definitely down.", alt: "Minion pins tumble beside a Definitely Not the Kingpin sign" },
  { image: draft, title: "Build-a-Ball", caption: "The Ballooninator is completely sure it knows best.", alt: "Ball ability draft offering Ballooninator, Tractor Ball and Shrinkinator" },
  { image: aim, title: "Aim. Power. Hook.", caption: "The power meter tops out at MAX PANTS.", alt: "The bowling aim, power and hook interface" },
  { image: arcade, title: "Between-turns arcade", caption: "Insert pants to play.", alt: "Minion Kong and Minion Invaders arcade cabinets" },
];
---

<BaseLayout title="NOPAS Bowling — Minion Panic Bowling" description="Explore NOPAS Bowling: real ten-pin rules, live Minion pins, Classic and Mayhem modes, ball abilities and lane mutations. Beta coming soon in the shared NOPAS universe.">
  <div class="nopas-overview bowling-page">
    <section class="overview-pad bowling-hero" aria-labelledby="bowling-title">
      <div class="bowling-hero-copy">
        <a class="overview-back" href="/nopas/#modes">← All three NOPAS modes</a>
        <p class="overview-eyebrow">SAME UNIVERSE. WHOLE NEW ALLEY.</p>
        <h1 id="bowling-title">NOPAS<br/><span>BOWLING</span></h1>
        <p class="bowling-subtitle">Minion Panic Bowling</p>
        <p class="bowling-lede">Ten pins. All of them Minions.<br/>None of them happy.</p>
        <div class="bowling-actions"><a class="overview-button overview-yellow" href="#basics">Learn the ropes ↓</a><a class="overview-button" href="#gallery">See the lanes ↓</a></div>
        <p class="overview-status"><span></span>Beta coming soon <b>/</b> Coming to Roblox</p>
      </div>
      <figure class="bowling-hero-picture"><Image src={pins} alt="Orange Minion bowling pins and a blue ball on the NOPAS lane" widths={[640,960,1280]} sizes="(min-width: 800px) 52vw, 100vw" loading="eager"/><figcaption>Development screenshot · Things may change before beta.</figcaption></figure>
    </section>
    <div class="bowling-stats" aria-label="Bowling at a glance">{[["4","Lanes"],["6","Players per lane"],["10","Frames of regret"],["300","Perfect game"]].map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</div>

    <section id="basics" class="overview-pad bowling-basics" aria-labelledby="basics-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">THE BASICS</p><h2 id="basics-title">Real bowling. Really.</h2></div><p>Keyboard, gamepad, and touch supported.<br/>Spectators welcome. Taunting encouraged.</p></div>
      <div class="bowling-basics-grid"><div><p>The UPDF converted a perfectly good recreational facility into a Minion disposal and training center. The rules are real ten-pin bowling. The pins are live, captured Minions. They have opinions about this.</p><p>Ten frames, strikes, spares, proper tenth-frame bonus throws, and a maximum score of 300. Underneath the chaos, the scoring stays real.</p><ol class="bowling-steps"><li><strong>Aim</strong><span>Line up across the lane.</span></li><li><strong>Power</strong><span>Lock your power.</span></li><li><strong>Hook</strong><span>Ride the hook meter. Hope the pins don't duck.</span></li></ol></div><figure><a href={aim.src} target="_blank" rel="noopener" aria-label="Open full-size aim, power and hook screenshot"><Image src={aim} alt="Bowling aim, power and hook meters" widths={[480,720,960]} sizes="(min-width: 800px) 48vw, 90vw" loading="lazy"/></a><figcaption>Development screenshot · Open to inspect the controls ↗</figcaption></figure></div>
    </section>

    <section id="bowling-modes" class="overview-pad bowling-modes" aria-labelledby="modes-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">PICK YOUR KIND OF BOWLING</p><h2 id="modes-title">Two modes. One apology letter.</h2></div><p>Classic keeps it simple.<br/>Mayhem turns everything up.</p></div>
      <div class="bowling-mode-grid">
        <article class="bowling-classic"><p class="overview-eyebrow">01 / CLASSIC MODE</p><h3>Just bowling.<br/>Sort of.</h3><p>Standard ten-pin rules, normal Minion pins, no abilities, no mutations. The purest test of skill NOPAS offers.</p><p>The Minions still flinch, taunt, cover their eyes, and occasionally try to sneak off the pin deck. That part is not configurable.</p><p class="bowling-gag">For purists, league night, and settling arguments properly.</p></article>
        <article class="bowling-mayhem"><p class="overview-eyebrow">02 / MAYHEM MODE</p><h3>Skill still wins.<br/>It just wins louder.</h3><p>Mutant Minion pins, a Build-a-Ball ability draft, announced lane mutations, Kingpin bounties, and mid-match bonus rounds—all layered on top of real bowling scoring.</p><p>The chaos doesn't change the rules for your bowling score.</p><a class="overview-button" href="#mayhem">What's in Mayhem? ↓</a></article>
      </div>
    </section>

    <section id="mayhem" class="overview-pad bowling-features" aria-labelledby="mayhem-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">MAYHEM MODE FIELD GUIDE</p><h2 id="mayhem-title">What could possibly go wrong?</h2></div><p>Open a feature to get the details.</p></div>
      <div class="bowling-feature-grid">{features.map((feature,i)=><details class="bowling-feature" open={i===0}><summary><span class="overview-eyebrow">{feature.tag}</span><strong>{feature.title}</strong><span class="bowling-disclosure" aria-hidden="true">+</span></summary><div><p>{feature.body}</p><p class="bowling-gag">{feature.note}</p></div></details>)}</div>
    </section>

    <section id="gallery" class="overview-pad bowling-gallery" aria-labelledby="gallery-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">FACILITY PHOTOS</p><h2 id="gallery-title">Postcards from the lanes.</h2></div><p>Actual development screenshots.<br/>Open any image for a closer look.</p></div>
      <div class="bowling-gallery-grid">{gallery.map(shot=><figure><a href={shot.image.src} target="_blank" rel="noopener" aria-label={`Open full-size screenshot: ${shot.title}`}><Image src={shot.image} alt={shot.alt} widths={[480,720,960]} sizes="(min-width: 1000px) 31vw, (min-width: 640px) 45vw, 90vw" loading="lazy"/><span aria-hidden="true">↗</span></a><figcaption><strong>{shot.title}</strong><span>{shot.caption}</span></figcaption></figure>)}</div>
    </section>

    <section class="overview-pad bowling-welfare" aria-labelledby="welfare-title"><figure><Image src={shrunken} alt="A small Shrunken Minion pin on the glowing pin deck" widths={[480,720]} sizes="(min-width: 800px) 40vw, 90vw" loading="lazy"/><figcaption>Development screenshot</figcaption></figure><div><p class="overview-eyebrow">A NOTE ON MINION WELFARE</p><h2 id="welfare-title">They're fine.</h2><p>Before every throw, the pins fidget, wave, taunt you, cover their eyes, and occasionally attempt to sneak off the deck before being dragged back into formation. After every throw, the survivors are swept up by tractor beam and re-racked, unharmed and deeply inconvenienced.</p><p class="bowling-gag">The Collectors filed a formal complaint. The UPDF filed it under “fan mail.”</p></div></section>
    <aside class="bowling-rules"><p class="overview-eyebrow">POSTED FACILITY RULES</p><p>No depantsing past the foul line. · Rental shoes do not include emergency pants. · Please return all balls and unauthorized trousers.</p><blockquote>“Bowling Minions are trained professionals. Probably.”<cite>Sign posted above Lane 1</cite></blockquote></aside>
    <section class="overview-pad bowling-universe"><div><p class="overview-eyebrow">ONE RIDICULOUS UNIVERSE. THREE WAYS TO PLAY.</p><h2>There's more chaos outside.</h2><p>Match, NOPAS Bowling, and NOPAS Survivors are planned for the upcoming beta. Timing and availability will be announced.</p></div><div><a class="overview-button" href="/nopas/#modes">Explore all three modes ↗</a><a class="overview-link" href="/nopas/defenders/">Meet the Defenders ↗</a></div></section>
  </div>
</BaseLayout>
