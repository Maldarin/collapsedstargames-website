---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { GAMES } from "../../../lib/games.mjs";
import { Image } from "astro:assets";
import pins from "../../../assets/bowling/minion-pins-card.png";
import lanes from "../../../assets/bowling/lanes-foul-line.png";
import specialBalls from "../../../assets/bowling/special-balls.png";
import pinsInFlight from "../../../assets/bowling/pins-in-flight.png";
import kingpin from "../../../assets/bowling/kingpin-tumble.png";
import strike from "../../../assets/bowling/strike.png";
import arcade from "../../../assets/bowling/arcade.png";
import shrunken from "../../../assets/bowling/shrunken-pin.png";
import mutation from "../../../assets/bowling/mutation-roll.png";
import "../../../styles/nopas-overview.css";
import "../../../styles/nopas-bowling.css";
import { PLAY_URL } from "../../../lib/links.mjs";

const features = [
  { tag: "MUTANT MINION PINS", title: "The pins fight back. Passively.", body: "On announced frames, mutant Minions join the rack. Magnet Pins pull your ball toward them. Mega Pins are big, heavy, and refuse to fall. Balloon Pins are full of air—hit POP while your ball is close and they burst.", note: "Topple a mutation you’ve never dropped before and it’s NEW MINION DISCOVERED, with bonus XP." },
  { tag: "SPECIAL BALLS", title: "UPDF weapons research, misapplied.", body: "Every Mayhem bowler carries three special balls. The Tractor Ball steers itself onto the head pin. The Laundry Ball bursts into a cloud of flying pants that knocks pins over. The Big Ball is huge and hits a wide path—great for spares that are far apart.", note: "You start with one charge. Strikes and spares earn more; gutter balls cost you one. Spend them wisely. Or don't." },
  { tag: "LANE EVENTS", title: "The lane has moods.", body: "Announced frames where the lane itself misbehaves. A Conveyor slides the pins left and right. Pinball Bumpers bounce your ball back out of the gutter. Wind shoves your ball off its line. Moon Gravity sends every pin you hit floating.", note: "Always announced before your throw. Never an excuse." },
  { tag: "KINGPIN BOUNTY", title: "One Minion thinks he's in charge.", body: "Some frames crown one pin the Kingpin—golden crown, mustache, and a ‘Definitely Not the Kingpin’ sign, all at once. Whoever knocks him down, on any throw, claims the bounty. If he survives, it grows and carries over to the next Kingpin frame, where someone else will absolutely steal it from you.", note: "Never changes your bowling score. Pays bowling XP. And bragging rights." },
  { tag: "BONUS ROUNDS", title: "Minion Panic, scheduled.", body: "Short mid-match interruptions where everyone on the lane plays at once. It’s AIM & FIRE!: flatten a charging Minion Stampede, shoot a giant rolling Minion back up the lane in Minion Avalanche, and close out the late game together in Boss Bowl—hit the bullseye, dodge the Minions it throws.", note: "Separate rewards. Your real score stays sacred." },
  { tag: "BETWEEN TURNS", title: "Waiting is also a game.", body: "Four lane-side arcade cabinets—Minion Kong, Minion Invaders, Plumber, and Minion Man—while you wait your turn, a dedicated taunt zone, and full celebrations when someone strings a Turkey—three strikes, one very confused turkey-costumed Minion.", note: "A perfect game gets a PERFECT GAME! crown and a ring of gold. Earn it." },
];
const gallery = [
  { image: mutation, title: "Mutation frame", caption: "Frame 7. Some of those pins are not normal.", alt: "A ball rolls toward orange Minion pins during a Mutation Frame" },
  { image: strike, title: "A very good throw", caption: "Strike. Kingpin claimed. Bounty collected.", alt: "A STRIKE celebration with a Kingpin bounty claimed" },
  { image: kingpin, title: "Definitely not the Kingpin", caption: "Moments before becoming definitely down.", alt: "Minion pins tumble beside a Definitely Not the Kingpin sign" },
  { image: specialBalls, title: "Special balls", caption: "Tractor, Laundry, Big. Plain is for cowards. And most throws.", alt: "A ball rolls into Minion pins next to the YOUR BALL panel listing Tractor Ball, Laundry Ball and Big Ball" },
  { image: pinsInFlight, title: "Pins in flight", caption: "This one did not consent to the trip.", alt: "A blue ball sends an orange Minion pin flying off the pin deck" },
  { image: arcade, title: "Between-turns arcade", caption: "Insert pants to play.", alt: "Minion Kong and Minion Invaders arcade cabinets" },
];
const otherGames = GAMES.filter((g) => g.id !== "bowling");
---

<BaseLayout title="Minion Panic Bowling — NOPAS" description="Explore Minion Panic Bowling: real ten-pin rules, live Minion pins, Classic and Mayhem modes, special balls and lane events in the shared NOPAS universe. Now in open beta on Roblox.">
  <div class="nopas-overview bowling-page">
    <section class="overview-pad bowling-hero" aria-labelledby="bowling-title">
      <div class="bowling-hero-copy">
        <a class="overview-back" href="/nopas/#games">← All NOPAS games</a>
        <p class="overview-eyebrow">SAME UNIVERSE. WHOLE NEW ALLEY.</p>
        <h1 id="bowling-title">MINION PANIC<br/><span>BOWLING</span></h1>
        <p class="bowling-subtitle">From the NOPAS universe</p>
        <p class="bowling-lede">Ten pins. All of them Minions.<br/>None of them happy.</p>
        <div class="overview-actions hero-play"><a class="overview-button overview-yellow" href={PLAY_URL} target="_blank" rel="noopener">▶ Play free on Roblox</a></div>
        <div class="bowling-actions"><a class="overview-button" href="#basics">Learn the ropes ↓</a><a class="overview-button" href="#gallery">See the lanes ↓</a></div>
        <p class="overview-status"><span></span>Open Beta <b>·</b> Live now on Roblox</p>
      </div>
      <figure class="bowling-hero-picture"><Image src={pins} alt="Orange Minion bowling pins and a blue ball on the NOPAS lane" widths={[640,960,1140]} sizes="(min-width: 800px) 52vw, 100vw" loading="eager"/><figcaption>Development screenshot · The beta is where it gets tuned.</figcaption></figure>
    </section>
    <div class="bowling-stats" aria-label="Bowling at a glance">{[["4","Lanes"],["6","Players per lane"],["10","Frames of regret"],["300","Perfect game"]].map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</div>

    <section id="basics" class="overview-pad bowling-basics" aria-labelledby="basics-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">THE BASICS</p><h2 id="basics-title">Real bowling. Really.</h2></div><p>Keyboard, gamepad, and touch supported.<br/>Spectators welcome. Taunting encouraged.</p></div>
      <div class="bowling-basics-grid"><div><p>The UPDF converted a perfectly good recreational facility into a Minion disposal and training center. The rules are real ten-pin bowling. The pins are live, captured Minions. They have opinions about this.</p><p>Ten frames, strikes, spares, proper tenth-frame bonus throws, and a maximum score of 300. Underneath the chaos, the scoring stays real.</p><p>Bowling has its own XP track at the Pro Shop: 25 levels, 5 prestige rings, and about 50 cosmetics—ball skins, celebration styles, lane flairs, and titles. Every one is unlocked by level or prestige. None of them cost Robux.</p><ol class="bowling-steps"><li><strong>Aim</strong><span>Line up across the lane.</span></li><li><strong>Power</strong><span>Lock your power.</span></li><li><strong>Curve</strong><span>Middle goes straight. Hope the pins don't duck.</span></li></ol></div><figure><a href={lanes.src} target="_blank" rel="noopener" aria-label="Open full-size screenshot of the lanes from the foul line"><Image src={lanes} alt="Two neon-lit NOPAS bowling lanes seen from the foul line, ball ready" widths={[480,720,960]} sizes="(min-width: 800px) 48vw, 90vw" loading="lazy"/></a><figcaption>Development screenshot · The view from the foul line ↗</figcaption></figure></div>
    </section>

    <section id="bowling-modes" class="overview-pad bowling-modes" aria-labelledby="modes-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">PICK YOUR KIND OF BOWLING</p><h2 id="modes-title">Two modes. One apology letter.</h2></div><p>Classic keeps it simple.<br/>Mayhem turns everything up.</p></div>
      <div class="bowling-mode-grid">
        <article class="bowling-classic"><p class="overview-eyebrow">01 / CLASSIC MODE</p><h3>Just bowling.<br/>Sort of.</h3><p>Standard ten-pin rules, normal Minion pins, no abilities, no mutations. The purest test of skill NOPAS offers.</p><p>The Minions still fidget, lean, get nervous, and jeer at you with actual voice lines. That part is not configurable.</p><p class="bowling-gag">For purists, league night, and settling arguments properly.</p></article>
        <article class="bowling-mayhem"><p class="overview-eyebrow">02 / MAYHEM MODE</p><h3>Skill still wins.<br/>It just wins louder.</h3><p>Mutant Minion pins, three special balls, announced lane events, Kingpin bounties, and mid-match bonus rounds—all layered on top of real bowling scoring.</p><p>The chaos doesn't change the rules for your bowling score.</p><a class="overview-button" href="#mayhem">What's in Mayhem? ↓</a></article>
      </div>
    </section>

    <section id="mayhem" class="overview-pad bowling-features" aria-labelledby="mayhem-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">MAYHEM MODE FIELD GUIDE</p><h2 id="mayhem-title">What could possibly go wrong?</h2></div><p>Open a feature to get the details.</p></div>
      <div class="bowling-feature-grid">{features.map((feature,i)=><details class="bowling-feature" open={i===0}><summary><span class="overview-eyebrow">{feature.tag}</span><strong>{feature.title}</strong><span class="bowling-disclosure" aria-hidden="true">+</span></summary><div><p>{feature.body}</p><p class="bowling-gag">{feature.note}</p></div></details>)}</div>
    </section>

    <section id="gallery" class="overview-pad bowling-gallery" aria-labelledby="gallery-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">FACILITY PHOTOS</p><h2 id="gallery-title">Postcards from the lanes.</h2></div><p>Actual development screenshots.<br/>Open any image for a closer look.</p></div>
      <div class="bowling-gallery-grid">{gallery.map(shot=><figure><a href={shot.image.src} target="_blank" rel="noopener" aria-label={`Open full-size screenshot: ${shot.title}`}><Image src={shot.image} alt={shot.alt} widths={[480,720,960]} sizes="(min-width: 1000px) 31vw, (min-width: 640px) 45vw, 90vw" loading="lazy"/><span aria-hidden="true">↗</span></a><figcaption><strong>{shot.title}</strong><span>{shot.caption}</span></figcaption></figure>)}</div>
    </section>

    <section class="overview-pad bowling-welfare" aria-labelledby="welfare-title"><figure><Image src={shrunken} alt="A lone Minion pin left standing on the glowing pin deck" widths={[480,720]} sizes="(min-width: 800px) 40vw, 90vw" loading="lazy"/><figcaption>Development screenshot</figcaption></figure><div><p class="overview-eyebrow">A NOTE ON MINION WELFARE</p><h2 id="welfare-title">They're fine.</h2><p>Before every throw, the pins fidget, lean, get nervous, and taunt you, then jeer out loud when you miss. Between throws, any pin still standing is respotted right where it stood. At frame end the leftovers ride a tractor beam out of the lane, unharmed and deeply inconvenienced, and a fresh rack drops in. Anyone loitering in the pit gets beamed up with them and fed to a giant Minion.</p><p class="bowling-gag">The Collectors filed a formal complaint. The UPDF filed it under “fan mail.”</p></div></section>
    <aside class="bowling-rules"><p class="overview-eyebrow">POSTED FACILITY RULES</p><p>No depantsing past the foul line. · Rental shoes do not include emergency pants. · Please return all balls and unauthorized trousers.</p><blockquote>“Bowling Minions are trained professionals. Probably.”<cite>Sign posted above Lane 1</cite></blockquote></aside>
    <section class="overview-pad bowling-universe"><div><p class="overview-eyebrow">ONE RIDICULOUS UNIVERSE. EVERY KIND OF CHAOS.</p><h2>There's more chaos outside.</h2><p>Minion Panic Bowling is one of the games in the NOPAS Lobby. The others are just as unreasonable, and they're all in the same open beta on Roblox.</p><a class="overview-button overview-yellow" href={PLAY_URL} target="_blank" rel="noopener">▶ Play free on Roblox</a></div><nav aria-label="Other NOPAS games"><ul class="universe-list">{otherGames.map(g=><li style={`--game:${g.color}`}><a href={g.href}><span class="overview-eyebrow">{g.tag}</span><strong>{g.name} →</strong></a></li>)}</ul></nav></section>
  </div>
</BaseLayout>
