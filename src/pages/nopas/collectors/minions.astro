---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import minionHero from "../../../assets/classes/Minions/Minion_solo.png";
import minionGroup from "../../../assets/classes/Minions/Minions_group.png";
import minionRun from "../../../assets/classes/Minions/Minion_run.png";
import minionCloseup from "../../../assets/classes/Minions/Minion_closeup.png";
import minionStreet from "../../../assets/classes/Minions/Minion_street.png";
import minionPair from "../../../assets/classes/Minions/Minion_pair.png";
import minionCharge from "../../../assets/classes/Minions/Minion_charge.png";
---

<BaseLayout
    title="The Minions — Collector Class"
    description="The Minions are the beating heart of the Collector invasion — a relentless swarm of little orange aliens that flood the streets, overwhelm defenses, and carry pants back to the mothership. Individually harmless. Collectively unstoppable."
>
    {/* ============================================================
        Hero
       ============================================================ */}
    <section class="relative overflow-hidden border-b border-[var(--color-alien-500)]/20">
        <div
            class="absolute inset-0 -z-10 pointer-events-none"
            style="background: radial-gradient(ellipse at 50% 35%, rgba(111,226,111,0.18), transparent 60%);"
        ></div>

        <div class="max-w-6xl mx-auto px-6 pt-10 pb-8 md:pt-12">
            <div class="flex items-center gap-4 text-xs tracking-[0.3em] uppercase font-display text-[var(--fg-soft)] mb-8">
                <a href="/nopas/" class="hover:text-[var(--fg-strong)] transition">Game</a>
                <span>/</span>
                <a href="/nopas/collectors/" class="hover:text-[var(--color-alien-400)] transition">Collectors</a>
                <span>/</span>
                <span class="text-[var(--color-alien-400)]">Minions</span>
            </div>

            <div class="grid md:grid-cols-2 gap-6 items-center">
                <div>
                    <p class="font-display text-xs md:text-sm tracking-[0.4em] text-[var(--color-alien-400)] uppercase">
                        Collector Class · The Swarm
                    </p>
                    <h1 class="font-display text-2xl md:text-4xl mt-3 text-paper-glow leading-tight">
                        THE <span class="text-[var(--color-alien-400)]">MINIONS</span>
                    </h1>
                    <p class="mt-6 text-[var(--fg-body)] italic text-lg">
                        Individually harmless. Collectively unstoppable.
                    </p>
                    <p class="mt-6 text-[var(--fg-body)] leading-relaxed">
                        The beating heart of the Collector invasion &mdash; a relentless
                        tide of little orange aliens that pours out of the mothership,
                        floods the streets, and gets to work removing pants at scale.
                    </p>
                    <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                        The Overlord schemes. The Commander advances. But it is the
                        Minions who actually do the collecting. There is always another
                        one. And another. And another.
                    </p>
                    <p class="mt-4 font-display text-xl text-[var(--color-alien-400)]">
                        &ldquo;You cannot depants the swarm. The swarm depants you.&rdquo;
                    </p>
                </div>
                <div class="relative aspect-square bg-[var(--bg-deep)] rounded-lg overflow-hidden">
                    <Image
                        src={minionHero}
                        alt="A Minion"
                        widths={[480, 720, 960, 1200]}
                        sizes="(min-width: 768px) 540px, 90vw"
                        class="w-full h-full object-contain"
                        loading="eager"
                    />
                </div>
            </div>
        </div>
    </section>

    {/* ============================================================
        Role Fantasy + Playstyle
       ============================================================ */}
    <section class="max-w-5xl mx-auto px-6 py-8 grid md:grid-cols-2 gap-10">
        <div>
            <p class="font-display text-xs tracking-[0.3em] text-[var(--color-alien-400)] uppercase">Role Fantasy</p>
            <h2 class="mt-3 font-display text-2xl md:text-3xl">Strength in numbers.</h2>
            <p class="mt-6 text-[var(--fg-body)] leading-relaxed">
                A single Minion is not a threat. A single Minion is a small confused
                alien with big eyes and questionable coordination. But Minions do not
                travel alone. They travel in <em>quantities.</em>
            </p>
            <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                Rush objectives, mob isolated Defenders, and pile onto pants faster
                than the UPDF can protect them. You do not need to win every fight.
                You just need to be everywhere at once.
            </p>
            <p class="mt-6 text-[var(--fg-soft)] italic leading-relaxed">
                The UPDF can stop one Minion.<br/>
                The UPDF cannot stop the concept of Minions.
            </p>
        </div>
        <div>
            <p class="font-display text-xs tracking-[0.3em] text-[var(--color-alien-400)] uppercase">Playstyle</p>
            <h2 class="mt-3 font-display text-2xl md:text-3xl">Flood. Overwhelm. Collect.</h2>
            <p class="mt-6 text-[var(--fg-body)] leading-relaxed">
                Minions are for players who want to be part of an unstoppable tide.
                Move as a pack, apply pressure everywhere, and keep the Defenders
                too busy to notice how many pants are quietly leaving the map.
            </p>
            <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                Follow the Overlord's calls. Push where the Commander breaks the line.
                Split the Defenders' attention, then converge on whatever they left
                undefended.
            </p>
            <p class="mt-4 text-[var(--fg-soft)] italic">
                Minions win by being <em>a lot</em>, in <em>a lot</em> of places, all at once.
            </p>
        </div>
    </section>

    {/* ============================================================
        In-game gallery
       ============================================================ */}
    <section class="max-w-7xl mx-auto px-6 py-8">
        <div class="text-center mb-6">
            <p class="font-display text-xs tracking-[0.4em] text-[var(--color-alien-400)] uppercase">
                The Invasion, In Progress
            </p>
            <h2 class="font-display text-2xl md:text-4xl mt-3 text-paper-glow">
                Spotted on the streets.
            </h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
            <div class="surface rounded-lg overflow-hidden md:col-span-2 md:row-span-2">
                <Image src={minionGroup} alt="A swarm of Minions advancing down the street" widths={[400, 600, 900]} sizes="(min-width: 768px) 60vw, 100vw" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="surface rounded-lg overflow-hidden">
                <Image src={minionRun} alt="A Minion running" widths={[240, 360, 480]} sizes="(min-width: 768px) 30vw, 50vw" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="surface rounded-lg overflow-hidden">
                <Image src={minionCloseup} alt="Close-up of a Minion" widths={[240, 360, 480]} sizes="(min-width: 768px) 30vw, 50vw" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="surface rounded-lg overflow-hidden">
                <Image src={minionStreet} alt="Minions spreading across a road" widths={[240, 360, 480]} sizes="(min-width: 768px) 30vw, 50vw" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="surface rounded-lg overflow-hidden">
                <Image src={minionPair} alt="A pair of Minions in the dark" widths={[240, 360, 480]} sizes="(min-width: 768px) 30vw, 50vw" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="surface rounded-lg overflow-hidden">
                <Image src={minionCharge} alt="A Minion charging forward" widths={[240, 360, 480]} sizes="(min-width: 768px) 30vw, 50vw" class="w-full h-full object-cover" loading="lazy" />
            </div>
        </div>
    </section>

    {/* ============================================================
        Traits / "Abilities"
       ============================================================ */}
    <section class="max-w-7xl mx-auto px-6 py-8">
        <div class="text-center mb-6">
            <p class="font-display text-xs tracking-[0.4em] text-[var(--color-alien-400)] uppercase">
                Combat Identity
            </p>
            <h2 class="font-display text-2xl md:text-4xl mt-3 text-paper-glow">
                Traits of the Swarm
            </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
            <div class="surface rounded-lg p-4 border border-[var(--color-alien-500)]/20">
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-alien-400)] uppercase">Numbers</p>
                <h3 class="mt-2 font-display text-lg">Relentless Reinforcement</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                    The mothership never runs out. Where one Minion falls, three more
                    are already jogging enthusiastically toward the objective.
                </p>
                <p class="mt-4 text-[var(--fg-soft)] italic text-sm leading-relaxed">
                    The UPDF calls it a manpower problem.<br/>The Collectors call it Tuesday.
                </p>
            </div>

            <div class="surface rounded-lg p-4 border border-[var(--color-alien-500)]/20">
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-alien-400)] uppercase">Objective Play</p>
                <h3 class="mt-2 font-display text-lg">Pants Retrieval</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                    The actual labor of the invasion. Minions grab pants, haul citizens,
                    and shuttle collected goods back toward the mothership while the
                    bigger units make noise.
                </p>
                <p class="mt-4 text-[var(--fg-soft)] italic text-sm leading-relaxed">
                    Small hands. Big commitment to logistics.
                </p>
            </div>

            <div class="surface rounded-lg p-4 border border-[var(--color-alien-500)]/20">
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-alien-400)] uppercase">Pressure</p>
                <h3 class="mt-2 font-display text-lg">Swarm Tactics</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                    Individually easy to ignore, which is exactly the trap. Split the
                    Defenders' focus, mob whoever wanders off alone, and overwhelm
                    positions the frontline cracked open.
                </p>
                <p class="mt-4 text-[var(--fg-soft)] italic text-sm leading-relaxed">
                    You were not surrounded by one Minion. You were surrounded by all of them.
                </p>
            </div>

            <div class="surface rounded-lg p-4 border border-[var(--color-alien-500)]/20">
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-alien-400)] uppercase">Coordination</p>
                <h3 class="mt-2 font-display text-lg">Follow the Command</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                    Minions thrive when the Overlord directs and the Commander leads
                    the push. Answer the calls, converge on marked targets, and turn
                    small alien chaos into large alien success.
                </p>
                <p class="mt-4 text-[var(--fg-soft)] italic text-sm leading-relaxed">
                    Alone, a wanderer. Together, a strategy.
                </p>
            </div>
        </div>
    </section>

    {/* ============================================================
        Lore
       ============================================================ */}
    <section class="max-w-3xl mx-auto px-6 py-8">
        <div class="surface rounded-lg p-5 md:p-6 border-l-2 border-[var(--color-alien-500)]/40">
            <p class="font-display text-xs tracking-[0.3em] text-[var(--color-alien-400)] uppercase">Lore</p>
            <h2 class="mt-3 font-display text-2xl md:text-3xl">Bred for enthusiasm, not paperwork.</h2>
            <p class="mt-6 text-[var(--fg-body)] leading-relaxed">
                The Minions were engineered by Collector scientists for exactly three
                purposes: to be numerous, to be eager, and to never, under any
                circumstances, ask why they are collecting pants.
            </p>
            <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                Collector records describe the Minions as
                <em class="text-[var(--fg-strong)]">&ldquo;an invaluable workforce.&rdquo;</em>
                UPDF records describe them as
                <em class="text-[var(--fg-strong)]">&ldquo;those little orange guys who just keep coming.&rdquo;</em>
            </p>
            <p class="mt-4 text-[var(--fg-soft)] italic">
                Both agree there are far, far too many of them.
            </p>
        </div>
    </section>

    {/* ============================================================
        Quotes pull-out
       ============================================================ */}
    <section class="max-w-5xl mx-auto px-6 py-8">
        <p class="font-display text-xs tracking-[0.4em] text-[var(--color-alien-400)] uppercase text-center">
            Field Recordings
        </p>
        <h2 class="font-display text-2xl md:text-3xl mt-3 text-paper-glow text-center">
            Heard on the battlefield.
        </h2>
        <div class="mt-10 grid md:grid-cols-2 gap-6">
            <blockquote class="surface rounded-lg p-4 text-sm text-[var(--fg-strong)] italic">
                &ldquo;There is one Minion. Oh. There are more Minions.&rdquo;
            </blockquote>
            <blockquote class="surface rounded-lg p-4 text-sm text-[var(--fg-strong)] italic">
                &ldquo;We ran out of ammo before they ran out of Minions.&rdquo;
            </blockquote>
            <blockquote class="surface rounded-lg p-4 text-sm text-[var(--fg-strong)] italic">
                &ldquo;Do not make eye contact. It only encourages them.&rdquo;
            </blockquote>
            <blockquote class="surface rounded-lg p-4 text-sm text-[var(--fg-strong)] italic">
                &ldquo;They took the pants. All of them. Efficiently.&rdquo;
            </blockquote>
            <blockquote class="surface rounded-lg p-4 text-sm text-[var(--fg-strong)] italic md:col-span-2 text-center">
                &ldquo;It's not a swarm if you name each one. Please stop naming them.&rdquo;
            </blockquote>
        </div>
    </section>

    {/* ============================================================
        Companion class CTA
       ============================================================ */}
    <section class="max-w-3xl mx-auto px-6 py-8 text-center border-t border-[var(--border-subtle)]">
        <p class="font-display text-xs tracking-[0.3em] text-[var(--fg-soft)] uppercase">Also on the Collector Roster</p>
        <div class="mt-4 grid sm:grid-cols-2 gap-6">
            <a href="/nopas/collectors/overlord/" class="block group">
                <h3 class="font-display text-2xl md:text-3xl text-paper-glow group-hover:text-[var(--color-magenta-300)] transition">
                    Meet the Overlord &nbsp;→
                </h3>
                <p class="mt-3 text-[var(--fg-muted)] text-sm">
                    The floating puppetmaster who tells the swarm where to go.
                </p>
            </a>
            <a href="/nopas/collectors/commander/" class="block group">
                <h3 class="font-display text-2xl md:text-3xl text-paper-glow group-hover:text-[#ffae3d] transition">
                    Meet the Commander &nbsp;→
                </h3>
                <p class="mt-3 text-[var(--fg-muted)] text-sm">
                    The frontline war machine who breaks the line the swarm pours through.
                </p>
            </a>
        </div>
    </section>
</BaseLayout>
