---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import overlordHero from "../../../assets/classes/Overlord/Overlord.png";
---

<BaseLayout
    title="The Overlord — Collector Class"
    description="The Overlord is the floating mastermind of the Collector invasion — part commander, part psychic menace, part workplace supervisor. Hover above the chaos, direct minions, freeze Defenders, and organize the pants-removal operation."
>
    {/* ============================================================
        Hero
       ============================================================ */}
    <section class="relative overflow-hidden border-b border-[var(--color-magenta-500)]/15">
        <div
            class="absolute inset-0 -z-10 pointer-events-none"
            style="background: radial-gradient(ellipse at 50% 35%, rgba(255,31,122,0.22), transparent 60%);"
        ></div>

        <div class="max-w-6xl mx-auto px-6 pt-10 pb-8 md:pt-12">
            <div class="flex items-center gap-4 text-xs tracking-[0.3em] uppercase font-display text-[var(--fg-soft)] mb-8">
                <a href="/nopas/" class="hover:text-[var(--fg-strong)] transition">Game</a>
                <span>/</span>
                <a href="/nopas/collectors/" class="hover:text-[var(--color-alien-400)] transition">Collectors</a>
                <span>/</span>
                <span class="text-[var(--color-magenta-400)]">Overlord</span>
            </div>

            <div class="grid md:grid-cols-2 gap-6 items-center">
                <div>
                    <p class="font-display text-xs md:text-sm tracking-[0.4em] text-[var(--color-magenta-400)] uppercase">
                        Collector Class · Puppetmaster
                    </p>
                    <h1 class="font-display text-2xl md:text-4xl mt-3 text-paper-glow leading-tight">
                        THE <span class="text-[var(--color-magenta-300)]">OVERLORD</span>
                    </h1>
                    <p class="mt-6 text-[var(--fg-body)] italic text-lg">
                        Why chase pants yourself when minions exist?
                    </p>
                    <p class="mt-6 text-[var(--fg-body)] leading-relaxed">
                        The floating mastermind of the Collector invasion &mdash;
                        part commander, part psychic menace, part workplace supervisor
                        with absolutely no regard for personal space.
                    </p>
                    <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                        Hover above the chaos, direct minions, freeze Defenders,
                        disrupt safe zones, and turn the battlefield into a carefully
                        organized pants-removal operation.
                    </p>
                </div>
                <div class="relative aspect-square bg-[var(--bg-deep)] rounded-lg overflow-hidden">
                    <Image
                        src={overlordHero}
                        alt="The Overlord"
                        widths={[480, 720, 960, 1200]}
                        sizes="(min-width: 768px) 540px, 90vw"
                        class="w-full h-full object-contain"
                        loading="eager"
                    />
                </div>
            </div>
        </div>
    </section>

    {/* ============================================================
        Role Fantasy + Playstyle
       ============================================================ */}
    <section class="max-w-5xl mx-auto px-6 py-8 grid md:grid-cols-2 gap-10">
        <div>
            <p class="font-display text-xs tracking-[0.3em] text-[var(--color-magenta-400)] uppercase">Role Fantasy</p>
            <h2 class="mt-3 font-display text-2xl md:text-3xl">A puppetmaster, not a brawler.</h2>
            <p class="mt-6 text-[var(--fg-body)] leading-relaxed">
                You are not the strongest Collector on the field. You are not supposed
                to be. Your strength comes from positioning, timing, and making
                everyone else fight on your terms.
            </p>
            <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                Float near the action. Stay protected. Use minions as pressure.
                Punish isolated Defenders. Break rescue attempts. Make citizens
                panic in the correct direction: toward collection.
            </p>
            <p class="mt-6 text-[var(--fg-soft)] italic leading-relaxed">
                The UPDF sees a glowing alien tyrant.<br/>
                The Collectors see excellent middle management.
            </p>
        </div>
        <div>
            <p class="font-display text-xs tracking-[0.3em] text-[var(--color-magenta-400)] uppercase">Playstyle</p>
            <h2 class="mt-3 font-display text-2xl md:text-3xl">Control. Disrupt. Strategize.</h2>
            <p class="mt-6 text-[var(--fg-body)] leading-relaxed">
                Watch the battlefield, pick priority targets, and create openings for
                the Collector team.
            </p>
            <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                If Defenders group up, disrupt them. If citizens hide, expose them.
                If minions swarm, guide the swarm. If things go badly, retreat with
                dignity and pretend it was part of the plan.
            </p>
            <p class="mt-4 text-[var(--fg-soft)] italic">
                Overlord players win by being annoying in exactly the right places.
            </p>
        </div>
    </section>

    {/* ============================================================
        Abilities
       ============================================================ */}
    <section class="max-w-7xl mx-auto px-6 py-8">
        <div class="text-center mb-6">
            <p class="font-display text-xs tracking-[0.4em] text-[var(--color-magenta-400)] uppercase">
                Combat Identity
            </p>
            <h2 class="font-display text-2xl md:text-4xl mt-3 text-paper-glow">
                Abilities & Loadout
            </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
            {/* Freeze Ray */}
            <div class="surface rounded-lg p-4 border border-[var(--color-magenta-500)]/20">
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-magenta-400)] uppercase">Ability</p>
                <h3 class="mt-2 font-display text-lg">Freeze Ray</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                    Stop Defenders in their tracks and make rescue attempts extremely
                    inconvenient.
                </p>
                <p class="mt-4 text-[var(--fg-soft)] italic text-sm leading-relaxed">
                    A frozen Defender is not defending.<br/>A frozen Defender is decor.
                </p>
            </div>

            {/* DePantsinator */}
            <div class="surface rounded-lg p-4 border border-[var(--color-magenta-500)]/20">
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-magenta-400)] uppercase">Signature Weapon</p>
                <h3 class="mt-2 font-display text-lg">DePantsinator</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                    A focused Collector beam designed for the ancient and noble art
                    of pants separation.
                </p>
                <p class="mt-4 text-[var(--fg-soft)] italic text-sm leading-relaxed">
                    The UPDF calls it horrifying.<br/>The Overlord calls it efficient.
                </p>
            </div>

            {/* Minion Direction */}
            <div class="surface rounded-lg p-4 border border-[var(--color-magenta-500)]/20">
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-magenta-400)] uppercase">Command</p>
                <h3 class="mt-2 font-display text-lg">Minion Direction</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                    The Overlord thrives when minions are nearby. Guide the swarm,
                    pressure weak zones, and turn small alien chaos into large alien
                    success.
                </p>
            </div>

            {/* Evil Eye Drone */}
            <div class="surface rounded-lg p-4 border border-[var(--color-magenta-500)]/20">
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-magenta-400)] uppercase">Setup Phase · Recon</p>
                <h3 class="mt-2 font-display text-lg">Evil Eye Drone</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                    During the setup phase, the Overlord can use the command terminal
                    aboard the mothership to scout with the Evil Eye Drone.
                </p>
                <p class="mt-4 text-[var(--fg-soft)] italic text-sm leading-relaxed">
                    Watch citizens. Track Defenders. Identify panic clusters.<br/>
                    Pretend this is not creepy.
                </p>
            </div>
        </div>
    </section>

    {/* ============================================================
        Lore
       ============================================================ */}
    <section class="max-w-3xl mx-auto px-6 py-8">
        <div class="surface rounded-lg p-5 md:p-6 border-l-2 border-[var(--color-magenta-500)]/40">
            <p class="font-display text-xs tracking-[0.3em] text-[var(--color-magenta-400)] uppercase">Lore</p>
            <h2 class="mt-3 font-display text-2xl md:text-3xl">Visionary. Commanding. Difficult to invite to lunch.</h2>
            <p class="mt-6 text-[var(--fg-body)] leading-relaxed">
                The Overlord was not chosen because of kindness, humility, or emotional
                availability. The Overlord was chosen because every invasion needs
                someone willing to hover above everyone else and say,
                &ldquo;Actually, the pants should go over there.&rdquo;
            </p>
            <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                Collector records describe the Overlord as
                <em>&ldquo;visionary, commanding, and difficult to invite to lunch.&rdquo;</em>
            </p>
            <p class="mt-4 text-[var(--fg-body)] leading-relaxed">
                UPDF records describe the Overlord as
                <em>&ldquo;that floating purple nightmare who keeps freezing people near the pants.&rdquo;</em>
            </p>
            <p class="mt-4 text-[var(--fg-soft)] italic">
                Both are accurate.
            </p>
        </div>
    </section>

    {/* ============================================================
        Quotes pull-out
       ============================================================ */}
    <section class="max-w-5xl mx-auto px-6 py-8">
        <p class="font-display text-xs tracking-[0.4em] text-[var(--color-magenta-400)] uppercase text-center">
            Field Recordings
        </p>
        <h2 class="font-display text-2xl md:text-3xl mt-3 text-paper-glow text-center">
            Heard on the battlefield.
        </h2>
        <div class="mt-10 grid md:grid-cols-2 gap-6">
            <blockquote class="surface rounded-lg p-4 text-sm text-[var(--fg-strong)] italic">
                &ldquo;Do not call it theft. Call it gravitational ownership transfer.&rdquo;
            </blockquote>
            <blockquote class="surface rounded-lg p-4 text-sm text-[var(--fg-strong)] italic">
                &ldquo;Minions, retrieve the leg coverings.&rdquo;
            </blockquote>
            <blockquote class="surface rounded-lg p-4 text-sm text-[var(--fg-strong)] italic">
                &ldquo;The Defenders are emotionally attached to fabric. Exploit this.&rdquo;
            </blockquote>
            <blockquote class="surface rounded-lg p-4 text-sm text-[var(--fg-strong)] italic">
                &ldquo;I have seen the future. It has no pants.&rdquo;
            </blockquote>
            <blockquote class="surface rounded-lg p-4 text-sm text-[var(--fg-strong)] italic md:col-span-2 text-center">
                &ldquo;Excellent panic distribution. Continue.&rdquo;
            </blockquote>
        </div>
    </section>

    {/* ============================================================
        Companion class CTA
       ============================================================ */}
    <section class="max-w-3xl mx-auto px-6 py-8 text-center border-t border-[var(--border-subtle)]">
        <p class="font-display text-xs tracking-[0.3em] text-[var(--fg-soft)] uppercase">Also on the Collector Roster</p>
        <a href="/nopas/collectors/commander/" class="block mt-4 group">
            <h3 class="font-display text-3xl md:text-4xl text-paper-glow group-hover:text-[#ffae3d] transition">
                Meet the Commander &nbsp;→
            </h3>
            <p class="mt-3 text-[var(--fg-muted)]">
                The frontline war machine. Where the Overlord schemes, the Commander advances.
            </p>
        </a>
    </section>
</BaseLayout>
