---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import gameLogoMain from "../../assets/brand/game_title_logo-main.png";
import battleLong from "../../assets/battle/long_battle.png";
import battle2 from "../../assets/battle/2v2.png";
---

<BaseLayout
    title="Not Our Pants, Alien Swine!"
    description="A fast, funny, class-based Roblox invasion game. The United Pants Defense Force protects Earth's pants supply from alien Collectors. Class-based combat, citizen rescue, base-defense chaos. Coming to Roblox."
>
    {/* ============================================================
        Hero — game title logo + premise
       ============================================================ */}
    <section class="relative overflow-hidden">
        <div class="absolute inset-0 -z-10 opacity-25 dark-only-backdrop">
            <Image src={battleLong} alt="" class="w-full h-full object-cover" loading="eager" />
        </div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-b from-[var(--bg-base)]/40 via-[var(--bg-base)]/80 to-[var(--bg-base)] dark-only-backdrop"></div>

        <div class="max-w-5xl mx-auto px-6 pt-10 pb-8 md:pt-14 text-center">
            <Image
                src={gameLogoMain}
                alt="Not Our Pants, Alien Swine!"
                widths={[480, 720, 960, 1200]}
                sizes="(min-width: 1024px) 900px, 90vw"
                class="mx-auto w-full max-w-3xl drop-shadow-[0_0_60px_rgba(255,31,122,0.4)]"
                loading="eager"
            />
            <p class="mt-8 text-lg md:text-2xl max-w-3xl mx-auto text-[var(--fg-strong)] leading-relaxed font-display tracking-wide">
                A fast, funny, class-based Roblox invasion game.
            </p>
            <p class="mt-6 text-base md:text-lg max-w-2xl mx-auto text-[var(--fg-body)] leading-relaxed">
                The <strong class="text-[var(--color-denim-400)]">United Pants Defense Force</strong>
                battles <strong class="text-[var(--color-alien-400)]">alien Collectors</strong> trying
                to steal Earth's most valuable resource: pants.
            </p>
            <p class="mt-4 text-sm tracking-[0.3em] text-[var(--color-magenta-400)] uppercase font-display">
                Coming to Roblox
            </p>
        </div>
    </section>

    {/* ============================================================
        Premise / pull-quote
       ============================================================ */}
    <section class="max-w-3xl mx-auto px-6 py-8 text-center">
        <p class="font-display text-2xl md:text-3xl text-paper-glow leading-tight">
            &ldquo;Every person deserves to have a good pair of jeans.<br/>
            This ends today.<br/>
            <span class="text-[var(--color-magenta-400)]">Not Our Pants, Alien Swine!</span>&rdquo;
        </p>
        <p class="mt-4 text-xs tracking-[0.3em] text-[var(--fg-soft)] uppercase font-display">
            UPDF Official Motto
        </p>
    </section>

    {/* ============================================================
        Three-phase timeline
       ============================================================ */}
    <section class="max-w-7xl mx-auto px-6 py-10">
        <div class="text-center mb-6">
            <p class="font-display text-xs tracking-[0.4em] text-[var(--color-magenta-400)] uppercase">
                Match Structure
            </p>
            <h2 class="font-display text-2xl md:text-4xl mt-3 text-paper-glow">
                Three phases. Escalating chaos.
            </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
            {/* Setup */}
            <article class="surface rounded-lg p-6 relative overflow-hidden">
                <div class="absolute top-0 right-0 font-display text-7xl text-[var(--fg-primary)]/5 leading-none p-4 pointer-events-none">01</div>
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-denim-400)] uppercase">Phase 1</p>
                <h3 class="mt-2 font-display text-lg">Setup</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed text-sm">
                    Before the invasion begins, Defenders get a short window to prepare.
                </p>
                <p class="mt-3 text-[var(--fg-body)] leading-relaxed text-sm">
                    Move citizens indoors. Build defenses. Set up safe zones. Repair what
                    you can. Panic efficiently.
                </p>
                <p class="mt-4 text-[var(--fg-soft)] italic text-sm leading-relaxed">
                    The UPDF calls it preparation.<br/>The aliens call it annoying.
                </p>
            </article>

            {/* Invasion */}
            <article class="surface rounded-lg p-6 relative overflow-hidden">
                <div class="absolute top-0 right-0 font-display text-7xl text-[var(--fg-primary)]/5 leading-none p-4 pointer-events-none">02</div>
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-alien-400)] uppercase">Phase 2</p>
                <h3 class="mt-2 font-display text-lg">Invasion</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed text-sm">
                    When the mothership opens, the Collectors come pouring in.
                </p>
                <p class="mt-3 text-[var(--fg-body)] leading-relaxed text-sm">
                    Alien minions swarm the streets. UFO beams light up the sky. Part
                    action game, part base defense, part rescue mission, part complete
                    neighborhood disaster.
                </p>
                <p class="mt-4 text-[var(--fg-soft)] italic text-sm leading-relaxed">
                    The aliens want pants.<br/>The UPDF brought blasters.
                </p>
            </article>

            {/* Final Stand */}
            <article class="surface rounded-lg p-6 relative overflow-hidden border border-[var(--color-magenta-500)]/20">
                <div class="absolute top-0 right-0 font-display text-7xl text-[var(--fg-primary)]/5 leading-none p-4 pointer-events-none">03</div>
                <p class="font-display text-xs tracking-[0.3em] text-[var(--color-magenta-400)] uppercase">Phase 3</p>
                <h3 class="mt-2 font-display text-lg">Final Stand</h3>
                <p class="mt-4 text-[var(--fg-body)] leading-relaxed text-sm">
                    If the Collectors gather enough pants, the battle moves to the
                    Pants Factory.
                </p>
                <p class="mt-3 text-[var(--fg-body)] leading-relaxed text-sm">
                    Cannons come online. Citizens panic. Defenders regroup. The
                    mothership looms overhead, ready to complete the most insulting
                    invasion in galactic history.
                </p>
                <p class="mt-4 text-[var(--fg-soft)] italic text-sm leading-relaxed">
                    Hold the factory. Protect the Golden Pants.<br/>Bring the
                    mothership down.
                </p>
            </article>
        </div>
    </section>

    {/* ============================================================
        Faction selector
       ============================================================ */}
    <section class="max-w-7xl mx-auto px-6 py-10">
        <div class="text-center mb-6">
            <p class="font-display text-xs tracking-[0.4em] text-[var(--color-magenta-400)] uppercase">
                Choose a side
            </p>
            <h2 class="font-display text-2xl md:text-4xl mt-3 text-paper-glow">
                Pick a faction. Pick a fight.
            </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            {/* Defenders */}
            <a href="/nopas/defenders/" class="group block surface rounded-lg overflow-hidden faction-defender hover:bg-[var(--surface-hover)] transition">
                <div class="relative aspect-[16/9] overflow-hidden">
                    <Image src={battle2} alt="" widths={[480, 720, 960]} sizes="(min-width: 768px) 600px, 90vw" class="w-full h-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-105 transition" loading="lazy" />
                    <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-base)] via-transparent to-transparent"></div>
                </div>
                <div class="p-6">
                    <p class="font-display text-xs tracking-[0.3em] text-[var(--color-denim-400)] uppercase">Defenders</p>
                    <h3 class="mt-2 font-display text-lg md:text-3xl">United Pants Defense Force</h3>
                    <p class="mt-3 text-[var(--fg-body)] text-sm leading-relaxed">
                        Specialized heroes with very questionable training and very strong
                        opinions about pants. Hold the line. Rescue citizens. Build the
                        defenses. Save Earth's denim.
                    </p>
                    <p class="mt-6 text-sm text-[var(--color-denim-400)] font-display tracking-wide group-hover:translate-x-1 transition-transform">
                        Meet the UPDF →
                    </p>
                </div>
            </a>

            {/* Collectors */}
            <a href="/nopas/collectors/" class="group block surface rounded-lg overflow-hidden faction-collector hover:bg-[var(--surface-hover)] transition">
                <div class="relative aspect-[16/9] overflow-hidden">
                    <Image src={battleLong} alt="" widths={[480, 720, 960]} sizes="(min-width: 768px) 600px, 90vw" class="w-full h-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-105 transition" loading="lazy" />
                    <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-base)] via-transparent to-transparent"></div>
                </div>
                <div class="p-6">
                    <p class="font-display text-xs tracking-[0.3em] text-[var(--color-alien-400)] uppercase">Collectors</p>
                    <h3 class="mt-2 font-display text-lg md:text-3xl">The Alien Collectors</h3>
                    <p class="mt-3 text-[var(--fg-body)] text-sm leading-relaxed">
                        An elite invasion force with one sacred mission: collect every pair
                        of pants Earth has foolishly left lying around on people. UFOs,
                        minions, beams, and deeply unnecessary confidence.
                    </p>
                    <p class="mt-6 text-sm text-[var(--color-alien-400)] font-display tracking-wide group-hover:translate-x-1 transition-transform">
                        Join the invasion →
                    </p>
                </div>
            </a>
        </div>
    </section>

    {/* ============================================================
        Tagline rotation strip
       ============================================================ */}
    <section class="border-y border-[var(--border-subtle)] py-10 my-12 overflow-hidden">
        <div class="max-w-6xl mx-auto px-6">
            <ul class="flex flex-wrap justify-center gap-x-12 gap-y-4 text-center text-[var(--fg-soft)] font-display text-sm tracking-wider uppercase">
                <li>Not our pants. Not today.</li>
                <li class="text-[var(--color-magenta-400)]/70">Defend Earth. Save the pants.</li>
                <li>The waistband war has begun.</li>
                <li class="text-[var(--color-magenta-400)]/70">No pants left behind.</li>
                <li>Earth's last defense has pockets.</li>
            </ul>
        </div>
    </section>
</BaseLayout>
