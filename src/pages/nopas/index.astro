---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoCard from "../../components/VideoCard.astro";
import GameSpotlight from "../../components/GameSpotlight.astro";
import GameGrid from "../../components/GameGrid.astro";
import { Image } from "astro:assets";
import gameLogo from "../../assets/brand/game_title_logo-main.png";
import defender from "../../assets/classes/SecurityOfficer/SecurityOfficer.png";
import minion from "../../assets/classes/Minions/Minion_solo.png";
import "../../styles/nopas-overview.css";
import "../../styles/nopas-patch-notes.css";
import { getCollection } from "astro:content";
import { publishedNewestFirst } from "../../lib/patch-notes.mjs";
import { PLAY_URL, COMMUNITY_URL, DISCORD_URL, YOUTUBE_URL } from "../../lib/links.mjs";
import { GAMES } from "../../lib/games.mjs";
const latestPatch = publishedNewestFirst(await getCollection("patchNotes"), { includeDrafts: import.meta.env.DEV })[0];

// Name every game from the list so the title, description and lede never state a count.
const names = GAMES.map((g) => g.name);
const gameList = `${names.slice(0, -1).join(", ")} and ${names[names.length - 1]}`;
const phases = [
  { name: "Invasion", intro: "The match opens with the mothership already overhead and the Collectors already on their way.", body: "Lead citizens into safe buildings, stop the minion raids, shoot down the drones snatching citizens off the street, and break captives out of the holding pens. The fight follows a Front that moves across Suburbia.", gag: "The aliens want pants. The UPDF brought blasters." },
  { name: "Final Stand", intro: "When the Invasion timer runs out (or sooner, if the Collectors bank their pants quota), the battle moves to the Pants Factory.", body: "Cannons come online. Citizens panic. Defenders regroup. The mothership looms overhead, ready to complete the most insulting invasion in galactic history.", gag: "Hold the factory. Protect the Golden Pants. Bring the mothership down." },
];
---

<BaseLayout title="Explore NOPAS — One ridiculous universe. Every kind of chaos." description={`Explore the NOPAS universe: ${gameList}. Meet the factions, watch gameplay, and pick your kind of chaos. Now in open beta on Roblox.`}>
  <div class="nopas-overview">
    <section class="overview-intro overview-pad" aria-labelledby="overview-title">
      <div>
        <a class="overview-back" href="/">← Collapsed Star Games</a>
        <p class="overview-eyebrow">WELCOME TO NOT OUR PANTS, ALIEN SWINE!</p>
        <h1 id="overview-title">One ridiculous universe.<br/><span>Every kind of chaos.</span></h1>
        <p class="overview-lede">The aliens want Earth's pants. The UPDF has objections.<br/>Meet the shared world behind {gameList}.</p>
        <div class="overview-actions"><a class="overview-button overview-yellow" href={PLAY_URL} target="_blank" rel="noopener">▶ Play free on Roblox</a><a class="overview-button" href="#gameplay">Watch gameplay ↓</a></div>
        <p class="overview-status"><span></span>Open Beta <b>/</b> Live now on Roblox</p>
      </div>
      <Image src={gameLogo} alt="Not Our Pants, Alien Swine!" widths={[480,720,960]} sizes="(min-width: 800px) 370px, 70vw" loading="eager" class="overview-logo"/>
    </section>
    {latestPatch && (
      <section class="overview-pad patch-teaser" aria-label="Latest patch">
        <p><span class="overview-eyebrow">LATEST PATCH · {latestPatch.data.version.toUpperCase()}</span><br/><strong>{latestPatch.data.title}</strong> — {latestPatch.data.summary}</p>
        <a class="overview-button" href={`/nopas/patch-notes/${latestPatch.id}/`}>Read the notes →</a>
      </section>
    )}

    <GameSpotlight />
    <section class="overview-pad overview-games" aria-labelledby="overview-games-title">
      <GameGrid skipIds={["match"]}><div class="overview-heading"><div><p class="overview-eyebrow">THE NOPAS UNIVERSE OF GAMES</p><h2 id="overview-games-title">Same aliens. New problems.</h2></div><p>One shared universe.<br/>All live now in the open beta on Roblox.</p></div></GameGrid>
    </section>

    <section id="gameplay" class="overview-pad overview-gameplay" aria-labelledby="footage-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">FIELD FOOTAGE / NOPAS</p><h2 id="footage-title">The waistband war, in motion.</h2></div><p>Actual gameplay footage.<br/>The beta is where it gets tuned.</p></div>
      <div class="overview-video-grid"><VideoCard id="kSqdf0DlD8s" title="Commander Depantsing"/><VideoCard id="-fuITOqPR1Q" title="The Commander Attacks"/><VideoCard id="CQkpU3rfi1E" title="Defender Gets Ballooninated"/></div>
      <a class="overview-link" href={YOUTUBE_URL} target="_blank" rel="noopener">More footage on YouTube ↗</a>
    </section>

    <section id="match" class="overview-pad overview-match" aria-labelledby="match-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">NOPAS: INVASION · OPEN BETA · LIVE NOW</p><h2 id="match-title">Two phases. No warm-up.</h2></div><a class="overview-link" href="#games">All NOPAS games ↑</a></div>
      <p class="overview-section-intro">The United Pants Defense Force battles alien Collectors trying to steal Earth's most valuable resource. Rescue the neighborhood, survive the Invasion, and hold the line at the Pants Factory. On phones, you can play any Defender class, Citizen included.</p>
      <div class="overview-phase-grid">{phases.map((phase,i) => <article class="overview-phase"><p class="overview-eyebrow">PHASE 0{i+1}</p><h3>{phase.name}</h3><p>{phase.intro}</p><p>{phase.body}</p><p class="overview-gag">{phase.gag}</p></article>)}</div>
    </section>

    <section id="factions" class="overview-pad overview-factions" aria-labelledby="factions-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">THE FACES BEHIND THE CHAOS</p><h2 id="factions-title">Pick a faction. Pick a fight.</h2></div><a class="overview-link" href="/lore/">Explore the lore ↗</a></div>
      <div class="overview-faction-grid">
        <a class="overview-faction" href="/nopas/defenders/"><Image src={defender} alt="UPDF Security Officer character artwork" widths={[360,600]} sizes="(min-width: 800px) 230px, 40vw" loading="lazy"/><div><p class="overview-eyebrow">THE DEFENDERS</p><h3>United Pants Defense Force</h3><p>Specialized heroes with very questionable training and very strong opinions about pants. Hold the line. Rescue citizens. Build the defenses. Save Earth's denim.</p><span class="overview-link">Meet the UPDF ↗</span></div></a>
        <a class="overview-faction" href="/nopas/collectors/"><Image src={minion} alt="Orange alien Minion character artwork" widths={[360,600]} sizes="(min-width: 800px) 230px, 40vw" loading="lazy"/><div><p class="overview-eyebrow">THE COLLECTORS</p><h3>The Alien Collectors</h3><p>An elite invasion force with one sacred mission: collect every pair of pants Earth has foolishly left lying around on people. UFOs, minions, beams, and deeply unnecessary confidence.</p><span class="overview-link">Meet the aliens ↗</span></div></a>
      </div>
      <p class="overview-art-note">Character artwork</p>
      <blockquote>“Every person deserves to have a good pair of jeans.<br/>This ends today. Not Our Pants, Alien Swine!”<cite>UPDF Official Motto</cite></blockquote>
    </section>
    <section class="overview-pad overview-contact"><div><p class="overview-eyebrow">NOT OUR PANTS. NOT TODAY.</p><h2>Earth's last defense has pockets.</h2><div class="overview-contact-links"><a class="overview-link" href={COMMUNITY_URL} target="_blank" rel="noopener">Join the Collapsed Star Games community on Roblox ↗</a><a class="overview-link" href={DISCORD_URL} target="_blank" rel="noopener">Join the NOPAS Discord ↗</a></div></div><div class="overview-actions"><a class="overview-button" href={PLAY_URL} target="_blank" rel="noopener">▶ Play free on Roblox</a><a class="overview-button" href="mailto:info@collapsedstargames.com">Press &amp; player inquiries ↗</a></div></section>
  </div>
</BaseLayout>
