---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoCard from "../../components/VideoCard.astro";
import { Image } from "astro:assets";
import gameLogo from "../../assets/brand/game_title_logo-main.png";
import matchArt from "../../assets/battle/2v2.png";
import bowlingPins from "../../assets/bowling/minion-pins.png";
import survivorsHorde from "../../assets/survivors/horde.png";
import defender from "../../assets/classes/SecurityOfficer/SecurityOfficer.png";
import minion from "../../assets/classes/Minions/Minion_solo.png";
import "../../styles/nopas-overview.css";

const modes = [
  { id: "match", name: "Match", color: "#74caff", tag: "DEFEND. INVADE. DEPANTS.", image: matchArt, alt: "Defenders and Collectors in NOPAS universe artwork", label: "Universe artwork", text: "Protect Earth's pants as a Defender—or join the alien Collectors and steal the lot.", action: "Explore Match" },
  { id: "bowling", name: "NOPAS Bowling", color: "#ffda56", tag: "BIG BALL. LITTLE ALIENS.", image: bowlingPins, alt: "Orange Minion pins and a blue bowling ball on a NOPAS lane", label: "Development screenshot", text: "Ten-pin bowling. Live Minion pins. A lane full of very questionable personalities.", action: "Explore Bowling" },
  { id: "survivors", name: "NOPAS Survivors", color: "#a9ef79", tag: "MORE MINIONS. SEND HELP.", image: survivorsHorde, alt: "A player faces a large horde of orange Minions", label: "Development screenshot", text: "The Minions are coming in waves. See how long you can keep the chaos under control.", action: "Explore Survivors" },
];
const phases = [
  { name: "Setup", intro: "Before the invasion begins, Defenders get a short window to prepare.", body: "Move citizens indoors. Build defenses. Set up safe zones. Repair what you can. Panic efficiently.", gag: "The UPDF calls it preparation. The aliens call it annoying." },
  { name: "Invasion", intro: "When the mothership opens, the Collectors come pouring in.", body: "Alien minions swarm the streets. UFO beams light up the sky. Part action game, part base defense, part rescue mission, part complete neighborhood disaster.", gag: "The aliens want pants. The UPDF brought blasters." },
  { name: "Final Stand", intro: "If the Collectors gather enough pants, the battle moves to the Pants Factory.", body: "Cannons come online. Citizens panic. Defenders regroup. The mothership looms overhead, ready to complete the most insulting invasion in galactic history.", gag: "Hold the factory. Protect the Golden Pants. Bring the mothership down." },
];
---

<BaseLayout title="Explore NOPAS — Three ways to play" description="Explore the NOPAS universe: Match, NOPAS Bowling, and NOPAS Survivors. Meet the factions, watch development gameplay, and discover three modes planned for the upcoming beta.">
  <div class="nopas-overview">
    <section class="overview-intro overview-pad" aria-labelledby="overview-title">
      <div>
        <a class="overview-back" href="/">← Collapsed Star Games</a>
        <p class="overview-eyebrow">WELCOME TO NOT OUR PANTS, ALIEN SWINE!</p>
        <h1 id="overview-title">One ridiculous universe.<br/><span>Three ways to play.</span></h1>
        <p class="overview-lede">The aliens want Earth's pants. The UPDF has objections.<br/>Meet the shared world behind Match, Bowling, and Survivors.</p>
        <a class="overview-button overview-yellow" href="#gameplay">▶ Watch gameplay</a>
        <p class="overview-status"><span></span>Beta coming soon <b>/</b> Coming to Roblox</p>
      </div>
      <Image src={gameLogo} alt="Not Our Pants, Alien Swine!" widths={[480,720,960]} sizes="(min-width: 800px) 370px, 70vw" loading="eager" class="overview-logo"/>
    </section>

    <section id="modes" class="overview-pad overview-modes" aria-labelledby="overview-modes-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">PICK YOUR KIND OF CHAOS</p><h2 id="overview-modes-title">Same aliens. New problems.</h2></div><p>All three modes are planned for the upcoming beta.<br/>Timing and availability will be announced.</p></div>
      <div class="overview-mode-grid">
        {modes.map((mode,i) => <article class="overview-mode" style={`--mode:${mode.color}`}>
          <div class="overview-mode-image"><Image src={mode.image} alt={mode.alt} widths={[480,720,960]} sizes="(min-width: 800px) 31vw, 90vw" loading="lazy"/><span class="overview-media-label">{mode.label}</span><b class="overview-number" aria-hidden="true">0{i+1}</b></div>
          <div class="overview-mode-copy"><p class="overview-eyebrow">{mode.tag}</p><h3>{mode.name}</h3><p>{mode.text}</p><p class="overview-beta">● Beta coming soon</p><a class="overview-button" href={`#${mode.id}`}>{mode.action} ↓</a></div>
        </article>)}
      </div>
    </section>

    <section id="gameplay" class="overview-pad overview-gameplay" aria-labelledby="footage-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">FIELD FOOTAGE / NOPAS</p><h2 id="footage-title">The waistband war, in motion.</h2></div><p>Actual development gameplay.<br/>Things may change before beta.</p></div>
      <div class="overview-video-grid"><VideoCard id="kSqdf0DlD8s" title="Commander Depantsing"/><VideoCard id="-fuITOqPR1Q" title="The Commander Attacks"/><VideoCard id="CQkpU3rfi1E" title="Defender Gets Ballooninated"/></div>
      <a class="overview-link" href="https://www.youtube.com/@CollapsedStarGames" target="_blank" rel="noopener">More footage on YouTube ↗</a>
    </section>

    <section id="match" class="overview-pad overview-match" aria-labelledby="match-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">01 / MATCH · BETA COMING SOON</p><h2 id="match-title">Three phases. Escalating chaos.</h2></div><a class="overview-link" href="#modes">All three modes ↑</a></div>
      <p class="overview-section-intro">The United Pants Defense Force battles alien Collectors trying to steal Earth's most valuable resource. Prepare the neighborhood, survive the invasion, and hold the line.</p>
      <div class="overview-phase-grid">{phases.map((phase,i) => <article class="overview-phase"><p class="overview-eyebrow">PHASE 0{i+1}</p><h3>{phase.name}</h3><p>{phase.intro}</p><p>{phase.body}</p><p class="overview-gag">{phase.gag}</p></article>)}</div>
    </section>

    <div class="overview-pad overview-extra-modes">
      <section id="bowling" class="overview-detail overview-bowling" aria-labelledby="bowling-title">
        <p class="overview-eyebrow">02 / NOPAS BOWLING · BETA COMING SOON</p><h2 id="bowling-title">The pins have complaints.</h2>
        <p>Real ten-pin bowling where every pin is a live, complaining Minion. Classic Mode for purists. Mayhem Mode for mutant pins, ball abilities, lane mutations, Kingpin bounties, and bonus rounds.</p>
        <p class="overview-gag">They signed up for an invasion. Nobody mentioned the bowling ball.</p>
        <a class="overview-button" href="/nopas/bowling/">Explore the bowling guide ↗</a>
      </section>
      <section id="survivors" class="overview-detail overview-survivors" aria-labelledby="survivors-title">
        <p class="overview-eyebrow">03 / NOPAS SURVIVORS · BETA COMING SOON</p><h2 id="survivors-title">Here comes the horde.</h2>
        <p>The Minions are coming in waves, and this time nobody is stopping to bowl them. A survivors-style mode in the same ridiculous NOPAS universe.</p>
        <p>Build around your class, collect Pants Scrap, and keep your squad standing. Coming in beta: Generator Defense, Protect the Citizens, and UFO Attacks.</p><a class="overview-button" href="/nopas/survivors/">Explore the survival guide ↗</a>
      </section>
    </div>

    <section id="factions" class="overview-pad overview-factions" aria-labelledby="factions-title">
      <div class="overview-heading"><div><p class="overview-eyebrow">THE FACES BEHIND THE CHAOS</p><h2 id="factions-title">Pick a faction. Pick a fight.</h2></div><a class="overview-link" href="/lore/">Explore the lore ↗</a></div>
      <div class="overview-faction-grid">
        <a class="overview-faction" href="/nopas/defenders/"><Image src={defender} alt="UPDF Security Officer character artwork" widths={[360,600]} sizes="(min-width: 800px) 230px, 40vw" loading="lazy"/><div><p class="overview-eyebrow">THE DEFENDERS</p><h3>United Pants Defense Force</h3><p>Specialized heroes with very questionable training and very strong opinions about pants. Hold the line. Rescue citizens. Build the defenses. Save Earth's denim.</p><span class="overview-link">Meet the UPDF ↗</span></div></a>
        <a class="overview-faction" href="/nopas/collectors/"><Image src={minion} alt="Orange alien Minion character artwork" widths={[360,600]} sizes="(min-width: 800px) 230px, 40vw" loading="lazy"/><div><p class="overview-eyebrow">THE COLLECTORS</p><h3>The Alien Collectors</h3><p>An elite invasion force with one sacred mission: collect every pair of pants Earth has foolishly left lying around on people. UFOs, minions, beams, and deeply unnecessary confidence.</p><span class="overview-link">Meet the aliens ↗</span></div></a>
      </div>
      <p class="overview-art-note">Character artwork</p>
      <blockquote>“Every person deserves to have a good pair of jeans.<br/>This ends today. Not Our Pants, Alien Swine!”<cite>UPDF Official Motto</cite></blockquote>
    </section>
    <section class="overview-pad overview-contact"><div><p class="overview-eyebrow">NOT OUR PANTS. NOT TODAY.</p><h2>Earth's last defense has pockets.</h2></div><a class="overview-button" href="mailto:info@collapsedstargames.com">Press &amp; player inquiries ↗</a></section>
  </div>
</BaseLayout>
