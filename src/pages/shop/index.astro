---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/nopas-utilities.css";

import { Image } from "astro:assets";
import gameLogoSecondary from "../../assets/brand/game_title_logo-secondary.png";
---

<BaseLayout
    title="NOPAS Shop"
    description="The official Not Our Pants, Alien Swine! shop is coming soon. Merch worthy of the United Pants Defense Force."
>
<div class="utility-pages shop-page"><section class="shop-hero"><div class="shop-copy"><a class="shop-back" href="/nopas/">← NOPAS universe</a><p class="utility-eyebrow">THE NOPAS SHOP</p><h1>Merch incoming.<br/><span>Pants stay on.</span></h1><div class="shop-status">COMING SOON</div><p>Merch worthy of the United Pants Defense Force is on its way. Pants not included — you'll need to defend your own.</p><a class="utility-button" href="/nopas/">Explore NOPAS ↗</a></div><figure class="shop-sign"><Image src={gameLogoSecondary} alt="Not Our Pants, Alien Swine!" widths={[480,720,960]} sizes="(min-width: 768px) 45vw, 90vw" loading="eager"/><figcaption>THE OFFICIAL NOPAS SHOP</figcaption><p>Coming soon.</p></figure></section><section class="shop-contact"><div><p class="utility-eyebrow">QUESTIONS IN THE MEANTIME?</p><h2>Contact the studio.</h2></div><a href="mailto:info@collapsedstargames.com">info@collapsedstargames.com ↗</a></section></div>
</BaseLayout>
