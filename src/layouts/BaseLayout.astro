---
import "../styles/global.css";
import "../styles/comic-themes.css";
import { Image } from "astro:assets";
import csgLogo from "../assets/brand/CSG-Logo_clean.png";
import { PLAY_URL, COMMUNITY_URL, DISCORD_URL, YOUTUBE_URL } from "../lib/links.mjs";
import { GAMES } from "../lib/games.mjs";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
}

// Header "Games" menu: every game, then the universe overview.
const gameLinks = [...GAMES.map((g) => ({ href: g.href, label: g.navLabel })), { href: "/nopas/", label: "All games" }];

// Default share image (1200x630) for every page that doesn't pass its own ogImage.
const DEFAULT_OG_IMAGE = "https://collapsedstargames.com/og/nopas-og-v2.jpg";
const { title, description = "Collapsed Star Games — an independent game studio building multiplayer and single-player games designed to be remembered, replayed, and shared.", ogImage = DEFAULT_OG_IMAGE } = Astro.props;
const fullTitle = title === "Collapsed Star Games" ? title : `${title} — Collapsed Star Games`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:image" content={ogImage} />
        {ogImage === DEFAULT_OG_IMAGE && <meta property="og:image:width" content="1200" />}
        {ogImage === DEFAULT_OG_IMAGE && <meta property="og:image:height" content="630" />}
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="icon" type="image/png" href="/favicon.png" />

        {/* Theme init — runs BEFORE first paint to avoid flash of wrong theme.
            Order: explicit user choice in localStorage > system preference > dark default. */}
        <script is:inline>
            (function () {
                try {
                    var saved = localStorage.getItem("csg-theme");
                    var preferLight =
                        window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
                    var theme = saved || (preferLight ? "light" : "dark");
                    document.documentElement.setAttribute("data-theme", theme);
                } catch (e) {
                    document.documentElement.setAttribute("data-theme", "dark");
                }
            })();
        </script>
    </head>
    <body class="min-h-screen flex flex-col">
        <header class="border-b border-[var(--border-subtle)] backdrop-blur-md sticky top-0 z-50 bg-[var(--header-bg)]">
            <nav class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between gap-4">
                <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="Collapsed Star Games — home">
                    <Image
                        src={csgLogo}
                        alt="Collapsed Star Games"
                        height={48}
                        widths={[96, 192]}
                        sizes="96px"
                        class="h-10 md:h-12 w-auto group-hover:scale-105 transition-transform"
                        loading="eager"
                    />
                </a>
                <div class="flex items-center gap-2 md:gap-4 lg:gap-8">
                    <ul class="hidden md:flex items-center md:gap-3 lg:gap-8 text-sm whitespace-nowrap">
                        <li><a href="/" class="hover:text-[var(--color-magenta-400)] transition">Studio</a></li>
                        {/* Games — a click/keyboard disclosure (not hover-only); behaviour in the script below */}
                        <li id="games-menu-wrap" class="relative">
                            <button
                                id="games-menu-toggle"
                                type="button"
                                aria-expanded="false"
                                aria-controls="games-menu"
                                class="group flex items-center gap-1 hover:text-[var(--color-magenta-400)] aria-expanded:text-[var(--color-magenta-400)] transition"
                            >Games<svg class="w-3 h-3 transition-transform group-aria-expanded:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 12 12" aria-hidden="true"><path stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M2.5 4.5 6 8l3.5-3.5"></path></svg></button>
                            <ul
                                id="games-menu"
                                class="hidden absolute left-0 top-full mt-3 min-w-52 py-2 rounded-md border border-[var(--border-strong)] bg-[var(--bg-elevated)] text-[var(--fg-primary)] shadow-lg"
                            >
                                {gameLinks.map((link) => (
                                    <li class={link.href === "/nopas/" ? "mt-1 pt-1 border-t border-[var(--border-medium)]" : undefined}>
                                        <a href={link.href} class="block px-4 py-2 hover:bg-[var(--surface-hover)] hover:text-[var(--color-magenta-400)] transition">{link.label}</a>
                                    </li>
                                ))}
                            </ul>
                        </li>
                        <li><a href="/nopas/defenders/" class="hover:text-[var(--color-denim-400)] transition">Defenders</a></li>
                        <li><a href="/nopas/collectors/" class="hover:text-[var(--color-alien-400)] transition">Collectors</a></li>
                        <li><a href="/nopas/stats/" class="hover:text-[var(--color-golden-400)] transition">Stats</a></li>
                        <li><a href="/nopas/patch-notes/" class="hover:text-[var(--color-golden-400)] transition">Patch Notes</a></li>
                        <li><a href="/lore/" class="hover:text-[var(--color-chaos-400)] transition">Lore</a></li>
                    </ul>
                    {/* Play — the Share Link, on every page. Fixed comic colors read on both header themes. */}
                    <a
                        href={PLAY_URL}
                        target="_blank"
                        rel="noopener"
                        class="font-display whitespace-nowrap text-xs px-3 py-2 rounded-md border-2 border-[#131326] bg-[#ffdb56] text-[#131326] hover:bg-[#ffe680] transition"
                    ><span aria-hidden="true">▶ </span>Play<span class="sr-only lg:not-sr-only"> on Roblox</span></a>
                    {/* Theme toggle */}
                    <button
                        id="theme-toggle"
                        type="button"
                        aria-label="Toggle light/dark mode"
                        title="Toggle light/dark mode"
                        class="p-2 rounded-md border border-[var(--border-medium)] hover:bg-[var(--surface-hover)] transition flex items-center justify-center"
                    >
                        {/* Sun icon — visible in dark mode (click to switch to light) */}
                        <svg
                            class="w-5 h-5 hidden dark-mode-icon"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                            aria-hidden="true"
                        >
                            <circle cx="12" cy="12" r="4.5" stroke-width="1.6"></circle>
                            <path stroke-width="1.6" stroke-linecap="round" d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5L19 19M5 19l1.5-1.5M17.5 6.5L19 5"></path>
                        </svg>
                        {/* Moon icon — visible in light mode (click to switch to dark) */}
                        <svg
                            class="w-5 h-5 hidden light-mode-icon"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                            aria-hidden="true"
                        >
                            <path stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"></path>
                        </svg>
                    </button>

                    {/* Mobile menu toggle — only on small screens; desktop uses the inline <ul> above */}
                    <button
                        id="mobile-menu-toggle"
                        type="button"
                        aria-label="Open menu"
                        aria-expanded="false"
                        aria-controls="mobile-menu"
                        class="md:hidden p-2 rounded-md border border-[var(--border-medium)] hover:bg-[var(--surface-hover)] transition flex items-center justify-center"
                    >
                        {/* Hamburger icon — visible when menu is closed */}
                        <svg
                            class="w-5 h-5 menu-open-icon"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                            aria-hidden="true"
                        >
                            <path stroke-width="1.6" stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                        {/* Close (X) icon — visible when menu is open */}
                        <svg
                            class="w-5 h-5 hidden menu-close-icon"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                            aria-hidden="true"
                        >
                            <path stroke-width="1.6" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            {/* Mobile menu panel — toggled by the hamburger; hidden on md+ where the inline nav shows */}
            <div id="mobile-menu" class="md:hidden hidden border-t border-[var(--border-subtle)] bg-[var(--header-bg)]">
                <ul class="max-w-7xl mx-auto px-6 py-3 flex flex-col text-base">
                    <li class="pb-2"><a href={PLAY_URL} target="_blank" rel="noopener" class="font-display block text-center text-sm px-4 py-3 rounded-md border-2 border-[#131326] bg-[#ffdb56] text-[#131326] hover:bg-[#ffe680] transition"><span aria-hidden="true">▶ </span>Play NOPAS on Roblox ↗</a></li>
                    <li><a href="/" class="block py-2.5 hover:text-[var(--color-magenta-400)] transition">Studio</a></li>
                    <li class="py-2.5">
                        <span id="mobile-games-label" class="block font-display text-xs tracking-wide text-[var(--fg-muted)]">Games</span>
                        <ul id="mobile-games" aria-labelledby="mobile-games-label" class="mt-1 pl-4 border-l-2 border-[var(--border-medium)]">
                            {gameLinks.map((link) => (
                                <li><a href={link.href} class="block py-2 hover:text-[var(--color-magenta-400)] transition">{link.label}</a></li>
                            ))}
                        </ul>
                    </li>
                    <li><a href="/nopas/defenders/" class="block py-2.5 hover:text-[var(--color-denim-400)] transition">Defenders</a></li>
                    <li><a href="/nopas/collectors/" class="block py-2.5 hover:text-[var(--color-alien-400)] transition">Collectors</a></li>
                    <li><a href="/nopas/stats/" class="block py-2.5 hover:text-[var(--color-golden-400)] transition">Stats</a></li>
                    <li><a href="/nopas/patch-notes/" class="block py-2.5 hover:text-[var(--color-golden-400)] transition">Patch Notes</a></li>
                    <li><a href="/lore/" class="block py-2.5 hover:text-[var(--color-chaos-400)] transition">Lore</a></li>
                </ul>
            </div>
        </header>

        <main class="flex-1">
            <slot />
        </main>

        <footer class="border-t border-[var(--border-subtle)] mt-24">
            <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-sm text-[var(--fg-soft)]">
                <div>
                    <p class="font-display text-base text-[var(--fg-body)]">COLLAPSED STAR GAMES, LLC</p>
                    <p class="mt-1">Independent game studio. United States.</p>
                    <p class="mt-1">Support: <a href="mailto:info@collapsedstargames.com" class="underline underline-offset-2 hover:text-[var(--fg-body)] transition">info@collapsedstargames.com</a></p>
                    <p class="mt-1"><a href="/shop/" class="underline underline-offset-2 hover:text-[var(--fg-body)] transition">Shop · Coming soon</a></p>
                    <p class="mt-1"><a href={PLAY_URL} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[var(--fg-body)] transition">Play NOPAS on Roblox ↗</a></p>
                    <p class="mt-1"><a href={COMMUNITY_URL} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[var(--fg-body)] transition">Join the Collapsed Star Games community on Roblox ↗</a></p>
                    <p class="mt-1"><a href={DISCORD_URL} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[var(--fg-body)] transition">Join the NOPAS Discord ↗</a> · <a href={YOUTUBE_URL} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[var(--fg-body)] transition">Watch on YouTube ↗</a></p>
                </div>
                <p>© {new Date().getFullYear()} Collapsed Star Games. All rights reserved.</p>
            </div>
        </footer>

        {/* Theme toggle behavior + icon visibility */}
        <script is:inline>
            (function () {
                var html = document.documentElement;
                var btn = document.getElementById("theme-toggle");
                var sunIcon = btn ? btn.querySelector(".dark-mode-icon") : null;
                var moonIcon = btn ? btn.querySelector(".light-mode-icon") : null;

                function syncIcons() {
                    var theme = html.getAttribute("data-theme") || "dark";
                    if (sunIcon && moonIcon) {
                        if (theme === "dark") {
                            sunIcon.classList.remove("hidden");
                            moonIcon.classList.add("hidden");
                        } else {
                            sunIcon.classList.add("hidden");
                            moonIcon.classList.remove("hidden");
                        }
                    }
                }

                syncIcons();

                if (btn) {
                    btn.addEventListener("click", function () {
                        var current = html.getAttribute("data-theme") || "dark";
                        var next = current === "dark" ? "light" : "dark";
                        html.setAttribute("data-theme", next);
                        try { localStorage.setItem("csg-theme", next); } catch (e) {}
                        syncIcons();
                    });
                }
            })();
        </script>

        {/* Mobile menu open/close */}
        <script is:inline>
            (function () {
                var btn = document.getElementById("mobile-menu-toggle");
                var menu = document.getElementById("mobile-menu");
                if (!btn || !menu) return;
                var openIcon = btn.querySelector(".menu-open-icon");
                var closeIcon = btn.querySelector(".menu-close-icon");

                function setOpen(open) {
                    menu.classList.toggle("hidden", !open);
                    if (openIcon) openIcon.classList.toggle("hidden", open);
                    if (closeIcon) closeIcon.classList.toggle("hidden", !open);
                    btn.setAttribute("aria-expanded", open ? "true" : "false");
                    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
                }

                btn.addEventListener("click", function () {
                    setOpen(menu.classList.contains("hidden"));
                });

                // Tapping a link navigates — close the panel so it isn't left open.
                menu.addEventListener("click", function (e) {
                    if (e.target.closest("a")) setOpen(false);
                });

                // If the viewport grows to desktop width, the inline nav takes over —
                // reset the panel so it can't be stuck open after a rotate/resize.
                window.matchMedia("(min-width: 768px)").addEventListener("change", function (e) {
                    if (e.matches) setOpen(false);
                });
            })();
        </script>
        {/* Games menu open/close — same aria/state pattern as the mobile menu */}
        <script is:inline>
            (function () {
                var wrap = document.getElementById("games-menu-wrap");
                var btn = document.getElementById("games-menu-toggle");
                var menu = document.getElementById("games-menu");
                if (!wrap || !btn || !menu) return;

                function isOpen() {
                    return btn.getAttribute("aria-expanded") === "true";
                }

                function setOpen(open) {
                    menu.classList.toggle("hidden", !open);
                    btn.setAttribute("aria-expanded", open ? "true" : "false");
                }

                // A real <button>: click, Enter and Space all arrive here.
                btn.addEventListener("click", function () {
                    setOpen(!isOpen());
                });

                // Escape closes from anywhere (Safari doesn't focus a clicked button,
                // so focus may be on <body>). Focus goes back to the button only if
                // it was inside the button + list.
                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && isOpen()) {
                        e.preventDefault();
                        var hadFocus = wrap.contains(document.activeElement);
                        setOpen(false);
                        if (hadFocus) btn.focus();
                    }
                });

                // Focus leaving the button + list (e.g. Tab past the last item) closes it.
                wrap.addEventListener("focusout", function (e) {
                    if (isOpen() && e.relatedTarget && !wrap.contains(e.relatedTarget)) setOpen(false);
                });

                // Pressing anywhere else closes it. pointerdown, not click: iOS/iPadOS
                // Safari sends no click for taps on non-interactive content.
                document.addEventListener("pointerdown", function (e) {
                    if (isOpen() && !wrap.contains(e.target)) setOpen(false);
                });

                // Choosing a link closes it (matters for same-page links like /nopas/#match).
                menu.addEventListener("click", function (e) {
                    if (e.target.closest("a")) setOpen(false);
                });

                // Below md the inline nav is hidden — reset so it can't come back stuck open.
                window.matchMedia("(min-width: 768px)").addEventListener("change", function (e) {
                    if (!e.matches) setOpen(false);
                });
            })();
        </script>
    </body>
</html>
